{
  "chapters": [
    {
      "id": "prologue",
      "title": "研究協力のお願い",
      "scenes": [
        {
          "id": "p1",
          "title": "授与所の午後",
          "on_enter": [
            "bg('bg/sando_afternoon.png')"
          ],
          "music": "bgm/daily_calm.mp3",
          "dialogue": [
            {
              "say": "その日の午後は、ほかのどの午後とも変わらなかった。"
            },
            {
              "say": "最後のひと束のお守りを授与所の木枠に並べ、指先で一つ一つの飾り結びをなぞっていく。——数は合っている。"
            },
            {
              "say": "境内の楠を伝って風が下りてくる。初秋の、乾いた涼しさをまとって。"
            },
            {
              "who": "結菜",
              "state": "laugh",
              "say": "葵——！こっちの絵馬、もういっぱいだよ。もう一箱、運んできていい？"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "うん。気をつけて運んでね。この前、転びかけたでしょう。"
            },
            {
              "who": "結菜",
              "state": "laugh",
              "say": "それ、いつの話——！"
            },
            {
              "say": "咲が、畳んだばかりの木札の山を抱えて、静かに歩いてくる。左手の枠に、寸分の狂いもなく並べていく。"
            },
            {
              "who": "咲",
              "state": "calm",
              "say": "……葵。これで、いい？"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "上出来。わたしより揃ってる。"
            },
            {
              "say": "咲の耳がそっと赤くなった。うつむいたけれど、口の端は上がっている。"
            },
            {
              "who": "葵",
              "say": "（早朝の参道に残る、掃き目のあと。玉串を差し出したとき、頭を下げるあの人たちの姿。……こういうものが、好きだ。）"
            },
            {
              "who": "葵",
              "say": "（それに、この二人。この小さな神社が、わたしたちの手で、一日また一日と、つつがなく回っていく。）"
            },
            {
              "say": "宮司はいつも言っていた。お前たち三人が、この社のこれからの支えだ、と。"
            },
            {
              "say": "氏子たちの目もそうだった。——ここを守っていく者として、わたしたちを見ていた。"
            },
            {
              "who": "葵",
              "say": "（そう期待されて、そう大切にされて。この重さは、ちゃんとわかっている。）"
            },
            {
              "who": "葵",
              "say": "（それを引き受けることを、わたしは心から望んでいる。）"
            }
          ],
          "choices": [
            {
              "text": "片づけて、社務所のほうへ",
              "goto": "p2",
              "sound": "sfx/step.mp3"
            }
          ]
        },
        {
          "id": "p2",
          "title": "軒の下",
          "dialogue": [
            {
              "say": "社務所で、宮司が電話をしていた。声が、いつもより低い。",
              "bg": "bg/shamusho_eaves.png"
            },
            {
              "say": "電話を切ったあと、彼は長いこと軒下に立っていた。"
            },
            {
              "who": "葵",
              "say": "（……この様子には、覚えがある。）"
            },
            {
              "say": "この神社と、なんにでも口を出したがる東京の本庁とは、昔からそりが合わない。"
            },
            {
              "say": "宮司は自分の社の作法を、自分のやり方を守る人だった。上から下りてくるものには、たいてい眉をひそめる。"
            },
            {
              "who": "葵",
              "say": "（何通の公文書を脇へ置いてきたか。何度、電話を二言三言で切ってきたか。……でも、今度は。）"
            },
            {
              "say": "今度ばかりは、彼はその話を脇へ置かなかった。"
            }
          ],
          "choices": [
            {
              "text": "（また上から何か来たの？）",
              "goto": "p3"
            }
          ]
        },
        {
          "id": "p3",
          "title": "来客",
          "dialogue": [
            {
              "say": "来たのは、本庁ではなかった。",
              "bg": "bg/shamusho_guests.png"
            },
            {
              "say": "別の人たちだった。——スーツ姿。丁寧で行き届いた物言い。体裁よく印刷された資料の束。"
            },
            {
              "say": "一度きりではなかった。"
            },
            {
              "say": "一度目、宮司は首を縦に振らなかった。二度目は、より周到な言い分を携えてきた。三度目には、社務所での話し合いが夜更けまで続くのが、こちらにも聞こえていた。"
            },
            {
              "who": "葵",
              "say": "（彼らが何を約束したのか、それとも何を宮司の前に差し出したのか——わたしは知らない。）"
            },
            {
              "who": "葵",
              "say": "（ただ、これだけはわかる。——この話を、誰かがひどく通したがっている。しかも、手間をかけて。）"
            }
          ],
          "choices": [
            {
              "text": "その日、宮司はわたしたちを一室に集めた",
              "goto": "p4"
            }
          ]
        },
        {
          "id": "p4",
          "title": "ひとつの願い",
          "dialogue": [
            {
              "who": "宮司",
              "say": "……『新産業計画』というものがあるそうだ。上から——いや、外から来た人たちが、この社に力を貸してほしいと言うておる。"
            },
            {
              "who": "宮司",
              "say": "近ごろは若い者が社から遠のいた。人の足も絶えた。何か新しい手立てを考えねば、この古いものを、この時代に生かしていくことも、思い出してもらうこともできん。"
            },
            {
              "who": "宮司",
              "say": "研究に協力してほしい、とのことだ。今のところ、大したことは求められておらん。——社の回りようを見せ、日々の儀式を記録し、いくつか話を聞く。それだけだ。"
            },
            {
              "say": "宮司は、少し間を置いた。"
            },
            {
              "who": "宮司",
              "say": "……継いでいくためだ。"
            },
            {
              "who": "葵",
              "say": "（そう言ったとき、この人が信じているのか、自分に言い聞かせているのか——わたしには、区別がつかなかった。）"
            }
          ],
          "choices": [
            {
              "text": "悪い話には聞こえない",
              "goto": "p5"
            }
          ]
        },
        {
          "id": "p5",
          "title": "うなずく",
          "dialogue": [
            {
              "who": "宮司",
              "say": "……そうだ。今度の儀式の記録には、葉山美咲も加わるそうだ。"
            },
            {
              "who": "結菜",
              "state": "laugh",
              "say": "えっ——！？美咲様？！あの、美咲様が？！"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（……美咲様。）"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（あの方とは、一度だけ、同じ儀式を務めた。あれからずっと、覚えている。）"
            },
            {
              "say": "結菜はもう興奮しきって咲の袖を掴んでいる。揺さぶられた咲はよろけながらも目を見開き、頬を赤くして——何も言わず、ただ、強くうなずいた。"
            },
            {
              "who": "結菜",
              "state": "laugh",
              "say": "だから参加するって言ったんだよ！美咲様と同じことができるなんて、探したって見つからないよ！"
            },
            {
              "who": "葵",
              "state": "laugh",
              "say": "（あんな人が、この話に加わる——）"
            },
            {
              "who": "葵",
              "state": "laugh",
              "say": "（わたしは、少し浮かれていた。）"
            },
            {
              "who": "葵",
              "state": "laugh",
              "say": "（わたしが大切にしてきたものを、誰かが手間をかけて、継がせようとしてくれている。）"
            },
            {
              "say": "わたしたち三人はうなずいた。ほかの皆と、同じように。"
            }
          ],
          "choices": [
            {
              "text": "……",
              "goto": "p6",
              "effects": [
                "bg('bg/shamusho_guests_dim.png')"
              ]
            }
          ]
        },
        {
          "id": "p6",
          "title": "ひと目",
          "dialogue": [
            {
              "say": "ただ、スーツの人たちの中に、ほとんど口をきかない一人がいた。——"
            },
            {
              "say": "わたしがうなずいたとき、その人が、こちらを見た。"
            },
            {
              "say": "何の表情もない、ひと目だった。"
            },
            {
              "who": "葵",
              "say": "（……）"
            },
            {
              "say": "わたしは、すぐに忘れた。"
            }
          ],
          "choices": [
            {
              "text": "（序章 · 了）",
              "goto": "p7"
            }
          ]
        },
        {
          "id": "p7",
          "title": "序章おわり",
          "dialogue": [
            {
              "say": "——第一章、まもなく始まる。"
            }
          ],
          "choices": [
            {
              "text": "（第一章 · 開始）",
              "goto": "c1_1"
            }
          ]
        }
      ]
    }
  ]
}
