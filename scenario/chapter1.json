{
  "chapters": [
    {
      "id": "chapter1",
      "title": "記録される日々",
      "scenes": [
        {
          "id": "c1_1",
          "title": "記録者",
          "on_enter": [
            "bg('bg/shamusho_guests.png')"
          ],
          "music": "bgm/daily_calm.mp3",
          "dialogue": [
            {
              "say": "約束の日、あの人たちは滞りなくやって来た。"
            },
            {
              "say": "先頭に立つのは四十がらみの、きちんとしたスーツの男。物腰は柔らかく、学のありそうな気配。手にはノートの束と、いくつかの小ぶりな機材。"
            },
            {
              "who": "間宮",
              "say": "初めまして。間宮と申します。今回の記録は、私が担当いたします。どうぞよろしくお願いいたします。"
            },
            {
              "say": "深々と頭を下げる。行き届きすぎた礼に、こちらのほうが恐縮してしまう。"
            },
            {
              "who": "間宮",
              "say": "皆さんが日々なさっていること——承載、祓、来る日も来る日もこの社を守り続けること——どれも、たいへん貴重なものです。失われかけている。惜しいことです。"
            },
            {
              "who": "間宮",
              "say": "我々がしたいのは、それをきちんと記録しておくことだけです。見て、書き留めて、時々いくつかお尋ねする。継いでいくために。"
            },
            {
              "who": "結菜",
              "state": "laugh",
              "say": "わたしたちを記録するの？その……いつも通りにやってるところを、見てるってこと？"
            },
            {
              "who": "間宮",
              "say": "その通りです。どうか、いつも通りに。皆さんのありのままの姿が、いちばんよいのです。"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（継いでいくために、記録を残す。……悪くない話に聞こえる。）"
            }
          ],
          "choices": [
            {
              "text": "では、いつも通りに",
              "goto": "c1_2"
            }
          ]
        },
        {
          "id": "c1_2",
          "title": "手本",
          "on_enter": [
            "bg('bg/haiden.png')"
          ],
          "dialogue": [
            {
              "say": "記録の本題は、神楽だった。"
            },
            {
              "say": "拝殿の上、三人は白衣に緋袴、それぞれ神楽鈴を手にする。太鼓が鳴り、笛が続く。古く、澄んだ音。"
            },
            {
              "say": "目を閉じ、ゆるやかに歩み、旋回する。鈴が指の間で細く鳴る。舞のひと型ひと型に、定められた数がある。——俯し、仰ぎ、進み、退き、鈴を挙げ、手を垂れる。一分の乱れも許されない。"
            },
            {
              "say": "中ほどまで舞ったところで、あの馴染んだ重さが来た。舞の軌跡をつたって、何かが少しずつ身体に降り、沈み込んでくる。"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（来た……。これが承載。わたしたちが担うべきものを、この身に受けること。）"
            },
            {
              "who": "葵",
              "state": null,
              "say": "（それを、きちんと神様の御前まで捧げていく。）"
            },
            {
              "say": "結菜の舞は熱く、鈴の音も高い。咲の舞は怯えたようで、それでいて一分の隙もない。わたしは真ん中で、静かに舞い、その重さを過たず身の内に収めていく。"
            },
            {
              "say": "間宮は階の下で、息を詰めるようにして記録していた。筆先が速い。その視線の大半は、わたしに落ちていた。"
            },
            {
              "say": "一舞、終わる。余韻が軒の端に散る。三人は鈴を下ろし、礼をした。"
            },
            {
              "who": "間宮",
              "say": "……見事です。本当に、見事だ。"
            },
            {
              "say": "顔を上げた彼の目には、隠しようのない讃嘆があった。"
            },
            {
              "who": "間宮",
              "say": "白石さん。失礼を承知で申し上げますが——あなたの舞は、私が見てきた中で最も清らかで、最も正確だ。承載があれほど安定していて、一分も多からず、一分も少なからず。"
            },
            {
              "who": "間宮",
              "say": "手本をひとつ、後世に遺すとすれば。あなた以上の適任はいません。"
            },
            {
              "who": "葵",
              "state": "laugh",
              "say": "（手本……わたしが？）"
            },
            {
              "who": "葵",
              "state": "laugh",
              "say": "（そう言われて、わたしは……言葉にならないほど、嬉しかった。）"
            },
            {
              "who": "結菜",
              "state": "laugh",
              "say": "当たり前じゃん！葵はわたしたちの中でいちばんすごいんだから！"
            },
            {
              "who": "咲",
              "state": "laugh",
              "say": "……うん。葵が、いちばん。"
            },
            {
              "say": "舞い終えると、いつもの余韻が満ちてくる。"
            },
            {
              "say": "承載を多く担うほど、身体は虚ろに、力が抜けていく。そっと中身を抜き取られたように。——けれどその虚ろのただ中へ、儀式の返しもまた流れ込んでくる。あたたかく、その空白をたっぷりと満たしていく。"
            },
            {
              "say": "虚ろであるほど、あたたかい。空であるほど、言葉にならない幸福に浸される。それが、今日はよく担えた証だと知っている。"
            },
            {
              "who": "葵",
              "state": "laugh",
              "say": "（ああ……またこの瞬間。）"
            },
            {
              "who": "葵",
              "state": "laugh",
              "say": "（全身の力が抜けて、それでいて、幸福で溶けてしまいそう。担うほどに、この余韻は濃くなる。——よく舞えた証。）"
            },
            {
              "say": "結菜と咲も、それぞれの舞を終えて、満ち足りた顔で寄ってくる。三人で殿の脇に並んで座り、誰も動く気になれないまま、余韻に浸っていた。"
            },
            {
              "who": "結菜",
              "state": "laugh",
              "say": "はぁ……今日も動きたくないくらい気持ちいい。神様、きっと今日もご満悦だよね？葵、すごく担いだでしょ。顔が光ってるもん。"
            },
            {
              "who": "咲",
              "state": "laugh",
              "say": "……うん。葵が、いちばん、幸せそう。"
            },
            {
              "say": "宮司が歩いてきた。三人が並んで伸びている様子を見て、めずらしく口元をゆるめ、こぼれた髪をひと筋、わたしの耳にかけた。何も言わなかった。"
            },
            {
              "say": "例によって、舞のあとには祓がある。承載のときに纏った、落としきれない滞りを祓い清める。これはいつも社で行う。——宮司が大麻を執り、左右に振り、低く祓詞を誦す。"
            },
            {
              "say": "馴染んだ儀軌、馴染んだ人。終えれば滞りも散り、あとには身体じゅうの、やわらかな余韻だけが残る。"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（仲間に寄り添われて、宮司に見守られて、こんな余韻に浸って——）"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（これが、わたしたちの日常。好きだ。どうしようもなく、好きだ。）"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（そして、手本と呼ばれ、こんなふうに認められて——あの場所に、また少し近づけたのだろうか。）"
            }
          ],
          "choices": [
            {
              "text": "（美咲様のような人に、少しでも近く）",
              "goto": "c1_3"
            }
          ]
        },
        {
          "id": "c1_3",
          "title": "もう一人",
          "dialogue": [
            {
              "say": "記録は何日も続いた。すべて滞りなく、楽しいとさえ言えるほどに。"
            },
            {
              "say": "ただ、間宮のそばには、いつももう一人がいた。"
            },
            {
              "say": "その人はほとんど口をきかない。記録も取らない。ただ、少し離れたところに立って、見ている。"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（あの日、社務所でわたしを一瞥した——あの人だ。）"
            },
            {
              "say": "その日の記録が終わりに近づいたころ、彼はふいに歩み寄って、口を開いた。声は平坦だった。"
            },
            {
              "who": "？？？",
              "say": "白石さん。あなたの承載は、一度でどこまで深く入れますか。"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "どこまで……？そうですね、普段の奉仕に要る程度までは。それより深くとなると、その時々によります。"
            },
            {
              "who": "？？？",
              "say": "祓は。どのくらいの間隔で。完全に戻りますか。"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "日々の祓は、宮司が自ら執ってくださいます。終われば、新しくなったようになります。"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "それより深くに積もったもの、うちの社では触れかねるものは、日を置いて阿闍梨さまにお越しいただき、より徹底した浄化をしていただきます。"
            },
            {
              "who": "？？？",
              "say": "……わかりました。ありがとうございます。"
            },
            {
              "say": "彼はうなずくと、元の位置に退いて、それきり口をきかなかった。"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（……ずいぶん細かく訊く人。でも、記録なのだから、細かいのは当たり前か。）"
            },
            {
              "say": "その小さな引っかかりを、わたしはすぐに忘れた。"
            }
          ],
          "choices": [
            {
              "text": "片づけを続ける",
              "goto": "c1_4"
            }
          ]
        },
        {
          "id": "c1_4",
          "title": "招き",
          "on_enter": [
            "bg('bg/shamusho_guests.png')"
          ],
          "dialogue": [
            {
              "say": "記録がひと区切りついた日、間宮はノートを閉じ、あらためて礼を述べた。"
            },
            {
              "who": "間宮",
              "say": "この数日、実に多くを学ばせていただきました。皆さんのご協力、しかと心に留めております。"
            },
            {
              "who": "間宮",
              "say": "それと——もう一つ、お願いがございます。"
            },
            {
              "who": "間宮",
              "say": "来月、恒例の祭儀があるとうかがいました。この社が毎年行っている、重い儀式だと。"
            },
            {
              "who": "間宮",
              "say": "皆さんにもご参加いただき、そのひとつの完結した儀式を、我々にきちんと記録させていただきたいのです。"
            },
            {
              "say": "彼は少し間を置き、何か嬉しいことを思い出したように、かすかに笑った。"
            },
            {
              "who": "間宮",
              "say": "ああ、それから——今回は、葉山美咲さんもいらっしゃいます。"
            },
            {
              "who": "結菜",
              "state": "laugh",
              "say": "えっ——！美咲様も来るの？！"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（美咲様が……いらっしゃる。）"
            },
            {
              "who": "葵",
              "state": "laugh",
              "say": "（あの方と同じ場に立って、同じ儀式に加わる——）"
            },
            {
              "who": "咲",
              "state": "laugh",
              "say": "（……わたしも、行きたい。あんな人を、この目で見たい。）"
            },
            {
              "who": "葵",
              "state": "laugh",
              "say": "（こんな機会、行かないわけがない。）"
            }
          ],
          "choices": [
            {
              "text": "必ず参加します",
              "goto": "c1_end"
            }
          ]
        },
        {
          "id": "c1_end",
          "title": "第一章おわり",
          "dialogue": [
            {
              "say": "わたしたち三人は、心から喜んで承諾した。"
            },
            {
              "say": "誰も、深くは考えなかった。——あの儀式が、書き留められたそれらのものが、わたしたちをどこへ連れていくのかを。"
            },
            {
              "say": "——第二章、まもなく始まる。"
            }
          ],
          "choices": [
            {
              "text": "（第二章 · 開始）",
              "goto": "c2_0"
            }
          ]
        }
      ]
    }
  ]
}
