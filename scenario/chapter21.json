      "scenes": [
        {
          "id": "c21_1",
          "title": "失定",
          "on_enter": [
            "bg('bg/lab_room.png')"
          ],
          "music": "bgm/tension_high.mp3",
          "dialogue": [
            {
              "say": "痛みが上がってきた。あなたは声を上げた。"
            },
            {
              "say": "そして、様子がおかしくなった。"
            },
            {
              "say": "これまでとは違う。これまでは、重さだった。圧しかかるもの、耐えるものだった。"
            },
            {
              "say": "今回は——受け止められない。"
            },
            {
              "say": "耐えられないのではない。受け止められないのだ。手を伸ばして受け止めようとしたのに、その手がもうそこにない、というように。"
            },
            {
              "who": "葵",
              "state": "bingfu_pain",
              "say": "（……何が、起きているの。）"
            },
            {
              "say": "機器が鳴り出した。"
            },
            {
              "say": "誰かが叫んでいる。足音が乱れる。"
            },
            {
              "who": "新田",
              "state": "default",
              "say": "失定です! 三チャンネル全線が偏移!"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "何だと? さっきまで問題なかったはず——"
            },
            {
              "say": "もう、聞き取れない。"
            },
            {
              "say": "目の前が真っ白になる。何かが自分の中から出ていく。止められない。"
            },
            {
              "say": "何かを掴もうとする。掴めない。"
            },
            {
              "who": "葵",
              "state": "bingfu_pain",
              "say": "（雫さんのときも……こんなふうだったのかな。）"
            },
            {
              "say": "そして、暗くなった。"
            }
          ],
          "choices": [
            {
              "text": "（……）",
              "goto": "c21_2"
            }
          ]
        },
        {
          "id": "c21_2",
          "title": "救援",
          "on_enter": [
            "bg('bg/lab_room.png')"
          ],
          "dialogue": [
            {
              "say": "あなたは薄く目を開けた。"
            },
            {
              "say": "部屋は人でいっぱいだった。"
            },
            {
              "say": "傍らで誰かが機器を組み立てている。ある声が数値を読み上げている。速く、そして落ち着いた声。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "——三号線をこちらへ。分流点は第二区間に取る。一度に流しすぎるな。"
            },
            {
              "say": "あなたはこの声を知っている。"
            },
            {
              "who": "葵",
              "state": "bingfu_pain",
              "say": "（……間瀬さん?）"
            },
            {
              "say": "彼が、戻ってきた。"
            },
            {
              "say": "コートを着たまま。どこかから直接駆けつけたらしく、着替える暇もなかったようだ。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "白石さん、聞こえますか。喋らなくていい。力を抜いて。"
            },
            {
              "say": "そして、あなたは彼女たちを見た。"
            },
            {
              "say": "千代と小夜が、すでに隣の二台に横たわっている。"
            },
            {
              "who": "千代",
              "state": "default",
              "say": "準備できました。"
            },
            {
              "who": "小夜",
              "state": "default",
              "say": "……はい。"
            },
            {
              "say": "小夜の声は震えていた。それでも、彼女はまっすぐに横たわっている。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "お二人とも、承載の分担はかなり辛い。耐えられなければ、いつでも言ってください。"
            },
            {
              "who": "千代",
              "state": "default",
              "say": "はい。"
            },
            {
              "say": "あなたは何か言おうとした。"
            },
            {
              "say": "この子たちを使わないで、と言いたかった。"
            },
            {
              "say": "口を開いたが、声が出なかった。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "始めます。"
            }
          ],
          "choices": [
            {
              "text": "（……）",
              "goto": "c21_3"
            }
          ]
        },
        {
