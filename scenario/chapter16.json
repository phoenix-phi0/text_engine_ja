            {
              "say": "少し、考えた。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "……わたしは、あの人を二度、助けました。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "一度目は、春の大祭のあと。あの人が不安定になって、三人で、代わりに分担しに行きました。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "二度目は、そのあとです。また崩れて、わたしたちが、また行きました。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "……それ以外は、知りません。あの人が普段どこにいて、何をして、どれだけ負載していたのか——わたしは、一度も見ていません。"
            },
            {
              "say": "間宮はうなずいて、書き留めた。"
            },
            {
              "who": "間宮",
              "state": "default",
              "say": "ええ。ほかには、何かありますか。"
            },
            {
              "say": "指を、握りしめた。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "……あります。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "監督の、あの三人の方。承載のあいだ、脇に立っています。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "笑いながら、話します。見ます。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "あれは、神に事えるときです。あれは、笑って見ていられるものでは、ありません。"
