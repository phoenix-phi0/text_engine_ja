          "title": "聴取",
          "on_enter": [
            "bg('bg/saikai_room.png')"
          ],
          "music": "bgm/daily_calm.mp3",
          "dialogue": [
            {
              "say": "体系が、聴取を行う。担当は、間宮だった。"
            },
            {
              "say": "小さな会議室で、ひとりずつ、呼ばれて入る。"
            },
            {
              "who": "間宮",
              "state": "default",
              "say": "白石さん、どうぞお掛けください。緊張なさらずに。ただ、状況を伺うだけです。"
            },
            {
              "say": "彼はノートを開き、ペンをかたわらに置いた。"
            },
            {
              "who": "間宮",
              "state": "default",
              "say": "桐生雫さんについて——ご存じのことを、すべてお話しください。"
