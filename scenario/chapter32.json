{
  "chapters": [
    {
      "id": "chapter32",
      "title": "後記",
      "scenes": [
        {
          "id": "c32_1",
          "title": "海",
          "on_enter": [
            "bg('bg/umi.png')"
          ],
          "music": "bgm/sad_gentle.mp3",
          "dialogue": [
            { "say": "汽車に六時間乗った。" },
            { "say": "降りてから、また長いこと歩いた。" },
            { "say": "海は、思っていたよりも大きかった。" },
            { "say": "二人は、砂浜に腰を下ろした。" },
            { "say": "咲が靴を脱いだ。" },
            { "say": "足を、砂の中にうずめる。" },
            { "who": "咲", "state": "xiazhuang", "say": "……冷たい。" },
            { "say": "あなたも靴を脱いだ。" },
            { "say": "砂は熱くて、その下は冷たかった。" },
            { "say": "あの大きな杉の木を、思い出した。" },
            { "say": "口には、出さなかった。" },
            { "say": "……" },
            { "say": "咲が鞄からおにぎりを二つ取り出した。" },
            { "who": "咲", "state": "xiazhuang", "say": "駅で買った。" },
            { "say": "二人は、そこに座って食べた。" },
            { "say": "長いあいだ、何も話さなかった。" },
            { "say": "波が、一つ、また一つと寄せてくる。" },
            { "who": "咲", "state": "xiazhuang", "say": "……これから、どうするつもり。" },
            { "say": "あなたは、少し考えた。" },
            { "who": "葵", "state": "xiazhuang", "say": "学籍は、残ってる。" },
            { "who": "葵", "state": "xiazhuang", "say": "休学しているだけ。" },
            { "say": "咲がうなずいた。" },
            { "who": "咲", "state": "xiazhuang", "say": "うん。私も。" },
            { "say": "彼女は海を見ていた。" },
            { "who": "咲", "state": "xiazhuang", "say": "……でも、戻ってからは?" },
            { "say": "あなたは、答えなかった。" },
            { "say": "あの教室を、思い出していた。" },
            { "say": "誰かが立ち上がって叫んだ、あの一言を思い出していた。" },
            { "say": "……" },
            { "who": "咲", "state": "xiazhuang", "say": "私、三年分の授業を落とした。" },
            { "who": "咲", "state": "xiazhuang", "say": "同期は、みんな卒業してる。" },
            { "say": "彼女は、砂を手のひらからこぼしていく。" },
            { "who": "咲", "state": "xiazhuang", "say": "戻って、あそこに座って——私は、誰と話せばいいんだろう。" },
            { "say": "波が、一つ、また一つと寄せてくる。" },
            { "who": "葵", "state": "xiazhuang", "say": "……私と話せばいい。" },
            { "say": "咲が振り向いた。" },
            { "who": "葵", "state": "xiazhuang", "say": "私も、やり直すから。" },
            { "who": "葵", "state": "xiazhuang", "say": "同じクラスに入れる。" },
            { "say": "咲は、しばらくあなたを見ていた。" },
            { "say": "そして、少し笑った。" },
            { "who": "咲", "state": "xiazhuang", "say": "……また班長になったりしないでよ。" },
            { "say": "あなたも、笑った。" },
            { "say": "二人は、また黙った。" },
            { "say": "陽が、傾き始めていた。" }
          ],
          "choices": [
            { "text": "（結菜）", "goto": "c32_2" }
          ]
        },
        {
          "id": "c32_2",
          "title": "一瞬",
          "on_enter": [
            "bg('bg/umi.png')"
          ],
          "dialogue": [
            { "say": "咲が砂をすくい上げ、また落とした。" },
            { "who": "咲", "state": "xiazhuang", "say": "……時々、あの子のことを思い出す。" },
            { "say": "誰のことか、あなたには分かる。" },
            { "who": "咲", "state": "xiazhuang", "say": "あの日、食堂で、花火を見に行かないかって誘ってくれた。" },
            { "who": "咲", "state": "xiazhuang", "say": "私、今度でいいって言った。" },
            { "say": "その手が、止まった。" },
            { "who": "咲", "state": "xiazhuang", "say": "今度は、なかった。" },
            { "say": "波が寄せて、また引いていく。" },
            { "say": "……" },
            { "who": "葵", "state": "xiazhuang", "say": "咲。" },
            { "who": "葵", "state": "xiazhuang", "say": "神様の一日は、私たちの一日とは違うんだって。" },
            { "say": "咲が振り向いた。" },
            { "who": "葵", "state": "xiazhuang", "say": "子どもの頃、宮司さまに聞いた。" },
            { "who": "葵", "state": "xiazhuang", "say": "こちらで三十年、五十年経っても——" },
            { "who": "葵", "state": "xiazhuang", "say": "あちらでは、ほんの一瞬なんだって。" },
            { "say": "あなたは海を見ていた。" },
            { "who": "葵", "state": "xiazhuang", "say": "だから、長くはない。" },
            { "who": "葵", "state": "xiazhuang", "say": "三十年でも、五十年でも。" },
            { "say": "……" },
            { "who": "葵", "state": "xiazhuang", "say": "私たちは、また結菜に会える。" },
            { "say": "あなたは、ごく当たり前のことのようにそう言った。" },
            { "say": "咲は、何も言わなかった。" },
            { "say": "長い時間が経って、彼女はあなたの肩に頭をあずけた。" },
            { "say": "その肩が、震えている。" },
            { "say": "あなたは、振り向かなかった。" },
            { "say": "海を、見ていた。" },
            { "say": "陽が、沈んでいった。" }
          ],
          "choices": [
            { "text": "（向こう側）", "goto": "c32_3" }
          ]
        },
        {
          "id": "c32_3",
          "title": "説明はなかった",
          "on_enter": [
            "bg('bg/gakko2.png')"
          ],
          "music": null,
          "dialogue": [
            { "say": "あちらからは、ついに何の説明もなかった。" },
            { "say": "謝りに来る者もいない。" },
            { "say": "説明しに来る者もいない。" },
            { "say": "収容しに来る者も、いなかった。" },
            { "say": "新学期が始まった。" },
            { "say": "学生課の中国語教師が、別の人に替わっていた。" },
            { "say": "異動した、とのことだった。" },
            { "say": "どこへ、とは言われなかった。" },
            { "say": "……" },
            { "say": "授業には出なければならない。課題も出さなければならない。" },
            { "say": "サークルの人が声をかけてくれば、彼も応える。" },
            { "say": "ポテトを売った日の写真は、まだグループに残っている。" },
            { "say": "誰かが、いいねを押していた。" },
            { "say": "圧力試験は、いまでも時おりやってくる。" },
            { "say": "決まりはない。" },
            { "say": "真夜中のこともある。授業中のこともある。" },
            { "say": "彼は机に突っ伏して、過ぎるのを待つ。" },
            { "say": "過ぎたら、また板書を写す。" },
            { "say": "……" },
            { "say": "魔霊は、まだ開いたままだ。" },
            { "say": "彼は時々、何文字か打っては、また消す。" },
            { "say": "こんなことを。" },
            { "say": "たとえ、口に出したところで。" },
            { "say": "……" },
            { "say": "誰が、信じるだろう。" },
            { "say": "……" },
            { "say": "——つづく。" }
          ],
          "end": true
        }
      ]
    }
  ]
}