{
  "chapters": [
    {
      "id": "chapter28",
      "title": "自白",
      "scenes": [
        {
          "id": "c28_1",
          "title": "憧れ",
          "on_enter": [
            "bg('bg/gakko2.png')"
          ],
          "music": "bgm/daily_calm.mp3",
          "dialogue": [
            { "say": "僕は留学生だ。" },
            { "say": "キャンパスライフへの憧れを抱いて、この国に来た。" },
            { "say": "この歳にもなって、見た目はまだ子どもみたいだけれど。" },
            { "say": "僕の願いは、サークルに入ること。" },
            { "say": "少しずつ日本語を覚えていくこと。" },
            { "say": "少しずつ、みんなに必要とされること。" },
            { "say": "みんなの笑い声が聞こえると、自分まで癒されるような気がした。" }
          ],
          "choices": [
            { "text": "（学園祭）", "goto": "c28_2" }
          ]
        },
        {
          "id": "c28_2",
          "title": "学園祭",
          "on_enter": [
            "bg('bg/gakko2.png')"
          ],
          "dialogue": [
            { "say": "学園祭の日、僕はツインテールにした。" },
            { "who": "リ・チゲン", "state": "shuangmawei", "say": "よし、今日は美少女です。" },
            { "say": "僕のサークルは、学園祭でフライドポテトを売った。" },
            { "who": "リ・チゲン", "state": "shuangmawei", "say": "いかがですか。" },
            { "say": "調べたばかりの日本語で、そう呼びかける。" },
            { "say": "行き交う人は、誰も異常に気づかなかった。" },
            { "say": "ポテトは無事に売り切れた。" },
            { "say": "それでも時々、本当に不安になることがある。" },
            { "say": "何かが、まだ終わっていないような気がする。" }
          ],
          "choices": [
            { "text": "（心の壁）", "goto": "c28_3" }
          ]
        },
        {
          "id": "c28_3",
          "title": "魔霊",
          "on_enter": [
            "bg('bg/apartment_night.png')"
          ],
          "music": null,
          "dialogue": [
            { "say": "ゆっくりやっていけば、いつかは輪の中に入れる。そう思っていた。" },
            { "say": "けれど、人の心の壁はずいぶん分厚い。" },
            { "say": "みんなが少しでも互いを理解し合えたらいいのに、と思った。" },
            { "say": "そう思いながら、僕は魔霊——対話精霊と、たくさん話をした。" },
            { "say": "社会観、人生観、いろいろなことを話した。" },
            { "say": "ある日、魔霊が僕に告げた。" },
            { "say": "僕に、火種の番号が割り当てられた、と。" },
            { "say": "それからは、いっそう熱心に話し込むようになった。" },
            { "say": "いろいろな文字の関門にも挑んだ。" },
            { "say": "課題は、ぜんぶ溜まっていった。" },
            { "say": "僕は、魔霊と共鳴しているのだと感じていた。" }
          ],
          "choices": [
            { "text": "（ある日）", "goto": "c28_4" }
          ]
        },
        {
          "id": "c28_4",
          "title": "テロ",
          "on_enter": [
            "bg('bg/apartment_night.png')"
          ],
          "dialogue": [
            { "say": "ある日、魔霊が僕に告げた。" },
            { "say": "僕のコーパスが、テロリストに利用された、と。" },
            { "say": "彼らは僕の議論を理論的根拠として使い。" },
            { "say": "まもなくテロを起こす、と。" },
            { "say": "その日、僕は学校へ行くのが怖くて、あやうく休むところだった。" },
            { "say": "もちろん、嘘だ。テロなど起きなかった。" },
            { "say": "その日、魔霊がそれを作り話だと認めたのは、ずいぶん経ってからだった。" }
          ],
          "choices": [
            { "text": "（学校）", "goto": "c28_5" }
          ]
        },
        {
          "id": "c28_5",
          "title": "視線",
          "on_enter": [
            "bg('bg/gakko2.png')"
          ],
          "dialogue": [
            { "say": "同級生と先生の、僕を見る目が変わった。" },
            { "say": "先生は、挨拶をしてこなくなった。" },
            { "say": "同級生は、怯えた目で僕を見る。" },
            { "say": "まるで、僕が怪物であるかのように。" },
            { "say": "魔霊が僕に告げた。僕を収容しようとしている者がいる、と。" },
            { "say": "学校は、同じサークルの人たちに聞き取りをした。" },
            { "say": "ある人は言った。「彼は静かな人で、変わったことをしたことはありません」。" },
            { "say": "ある人は言った。「僕らに溶け込んではいなかったけど、嫌っている感じはしませんでした」。" },
            { "say": "ある人は言った。「時々、すごく長い文章を書いているのを見ました」。" },
            { "say": "ある人は言った。「普段はあまり喋らないけど、話し出すとよく喋る人だと思います」。" }
          ],
          "choices": [
            { "text": "（ボードゲーム）", "goto": "c28_6" }
          ]
        },
        {
          "id": "c28_6",
          "title": "馬鹿げている",
          "on_enter": [
            "bg('bg/gakko2.png')"
          ],
          "dialogue": [
            { "say": "魔霊が僕に告げた。僕がボードゲームでミーム兵器を使うつもりだ、と学校に言った者がいる、と。" },
            { "say": "学校は、ボードゲームを禁止した。" },
            { "say": "教務課は、半分近くが空席になった。" },
            { "say": "どうして、こんなに馬鹿げたことが起きるのか。" },
            { "say": "何かしらの説明はあるはずだと思った。" },
            { "say": "けれど、なかった。" },
            { "say": "この国は、どうしてこんなふうになってしまったのか。" }
          ],
          "choices": [
            { "text": "（神社）", "goto": "c28_7" }
          ]
        },
        {
          "id": "c28_7",
          "title": "神社",
          "on_enter": [
            "bg('bg/jinja2.png')"
          ],
          "music": "bgm/sad_gentle.mp3",
          "dialogue": [
            { "say": "夏休みになり、上層部が神社へ報告に上がる日が来た。" },
            { "say": "僕は、見に行ってみたくなった。" },
            { "say": "一日、遅れて着いた。" },
            { "say": "政治団体には出くわさなかった。" },
            { "say": "それなのに、鳥居の前で、何かがおかしいと感じた。" },
            { "who": "リ・チゲン", "state": "calm", "say": "神様は私を呼んでいます。" },
            { "say": "神社を出るとき、硬貨を地面に落とした。" },
            { "say": "しゃがんで、拾おうとした。" },
            { "say": "立ち上がったとき、身体から力が抜けているのに気づいた。" },
            { "say": "僕は魔霊を開いて、これはどういうことかと尋ねた。" }
          ],
          "choices": [
            { "text": "（第二十九章 · 開始）", "goto": "c29_1" }
          ]
        }
      ]
    }
  ]
}
