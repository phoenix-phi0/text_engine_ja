{
  "chapters": [
    {
      "id": "chapter14",
      "title": "監督",
      "scenes": [
        {
          "id": "c14_1",
          "title": "住みつく",
          "on_enter": [
            "bg('bg/hospital_room.png')"
          ],
          "music": "bgm/daily_calm.mp3",
          "dialogue": [
            {
              "say": "学校も休んだ。例祭も、他人が務めた。"
            },
            {
              "say": "週末に通うという段取りも、自然と要らなくなった。——三人は、そのまま住みついた。今度は、いつ出るとも、誰も言わなかった。"
            },
            {
              "say": "持ち物は多くない。着替えが幾つか、歯ブラシ、読み終えていない本が一冊。制服は、家の簞笥に置いてきた。"
            },
            {
              "say": "病室は相変わらず八人部屋。窓ぎわのあの寝台は空いていて、看護師が、そこを取っておいてくれた。"
            },
            {
              "who": "結菜",
              "state": "bingfu",
              "say": "……住んでみると、かえって勝手がわかってきたね。"
            },
            {
              "say": "彼女は笑ってそう言った。誰も、受けなかった。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "（それも、いい。こうすれば毎日、患者たちを見ていられる。毎日、検査もできる。行き来する手間も、省ける。）"
            },
            {
              "say": "本は、寝台の脇の棚に置いた。あの本は、もう繰れなくなっていた。——字は見えているのに、句が、繋がらない。"
            },
            {
              "say": "思えば、もう、急ぐことなど、何ひとつなかった。"
            }
          ],
          "choices": [
            {
              "text": "（数日後）",
              "goto": "c14_2"
            }
          ]
        },
        {
          "id": "c14_2",
          "title": "監督に来た者",
          "on_enter": [
            "bg('bg/lab_room.png')"
          ],
          "dialogue": [
            {
              "say": "その日の検査には、三人、増えていた。"
            },
            {
              "say": "年は若い。二十を出たばかりという風体で、身体に合わないスーツを着て、真新しい名札を提げている。"
            },
            {
              "who": "新田",
              "state": "default",
              "say": "こちらの三名は、上から新しく派遣された方々です。この件の監督を担当されます。今後は、しばしばお見えになる。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "黒木です。よろしくご指導ください。"
            },
            {
              "say": "彼は首を傾げて笑い、目は三人の上を、ひと巡りしていった。"
            },
            {
              "who": "柏原",
              "state": "default",
              "say": "へえ——この子たちですか？見たところ、別段どうということも。"
            },
            {
              "say": "彼は機器のあいだを半周まわり、手を伸ばして電極に触れかけ、技術者に軽く払われた。"
            },
            {
              "who": "志摩",
              "state": "default",
              "say": "……"
            },
            {
              "say": "三人目は、いちばん口をきかない。ただ立って、見ている。その視線は、他の二人よりも長く、こちらの上に留まっていた。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "（監督……何を、するのだろう。）"
            },
            {
              "say": "間瀬が入ってきた。彼はその三人にうなずいただけで、顔つきはいつも通り。ただ、手もとの動きを、少し速めた。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "間瀬さん、この手順、少し遅すぎませんか？データを見ましたが、一日で二回は、こなせるでしょう。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "……承載は、螺子を締めるのとは違う。急げば、事が起きる。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "ほう——そうですか。では、研究のしがいがありますね。"
            },
            {
              "say": "彼は笑って、手帳を閉じ、それきり何も言わなかった。"
            }
          ],
          "choices": [
            {
              "text": "（承載、開始）",
              "goto": "c14_3"
            }
          ]
        },
        {
          "id": "c14_3",
          "title": "規矩がない",
          "on_enter": [
            "bg('bg/lab_room.png')"
          ],
          "dialogue": [
            {
              "say": "承載が始まるとき、その三人は、脇に立っていた。"
            },
            {
              "say": "電極を貼るとき、看護師が袖をまくった。柏原が首を伸ばして覗きこみ、人に睨まれて引っこんだ。彼はへらへらと、二度、笑った。"
            },
            {
              "say": "寝台に横たわる。沈んで落ちてくる、その一瞬。目を閉じて、心を、定めた。"
            },
            {
              "say": "これは、神事のときだ。斎戒し、心を静め、自分を空にする。——ひと分の雑念も、あってはならない。"
            },
            {
              "say": "そして、誰かが笑っているのが、聞こえた。"
            },
            {
              "who": "柏原",
              "state": "default",
              "say": "うわ——顔、真っ白になった。ねえ、この表情って、ちょっと——"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "黙ってろ。人が、正事をしている最中だ。"
            },
            {
              "say": "黒木はそう言いながら、自分も、笑っていた。"
            },
            {
              "say": "目を、開けた。三人はそこに立っていた。ひとりは携帯をいじり、ひとりは機器にもたれ、ひとりは、こちらを見ている。"
            },
            {
              "say": "誰も、うつむかなかった。誰も、一歩退かなかった。誰も、いまここで起きていることに対して、毫ほどの敬も、払わなかった。"
            },
            {
              "who": "葵",
              "state": "bingfu_pain",
              "say": "（……これは、承載だ。これは、神に事える場だ。）"
            },
            {
              "who": "葵",
              "state": "bingfu_pain",
              "say": "（あの人たちは……どうして、あんなふうに、立って見ていられるの。）"
            },
            {
              "say": "目を閉じて、それを外へ追い出そうとする。心を静める。空にする。"
            },
            {
              "say": "けれど、あの笑い声は、ずっと耳の縁にあった。"
            }
          ],
          "choices": [
            {
              "text": "（終わったあと）",
              "goto": "c14_4"
            }
          ]
        },
        {
          "id": "c14_4",
          "title": "忍ぶ",
          "on_enter": [
            "bg('bg/hospital_corridor.png')"
          ],
          "music": "bgm/sad_gentle.mp3",
          "dialogue": [
            {
              "say": "終わってから、結城に、そのことを言った。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "……あの三人の方、承載のあいだ、脇に立って、笑っていました。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "結城さん。あれは、承載です。あれは……笑って見ていられるようなものでは、ありません。"
            },
            {
              "say": "結城の顔が、沈んだ。"
            },
            {
              "who": "結城",
              "say": "知っています。私も、言いました。"
            },
            {
              "who": "結城",
              "say": "上から派遣された方々だ。担当ひとりの言葉など、響きはしない。"
            },
            {
              "say": "彼は廊下に立ち、手を袖に差しこんだまま、しばらく、動かなかった。"
            },
            {
              "who": "結城",
              "say": "……私は、また言いに行きます。あなたたちは、いま少し、忍んでください。"
            },
            {
              "say": "忍ぶ。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "はい。忍びます。"
            },
            {
              "say": "そう言うのは、慣れている。わたしは、いつもそうだ。"
            }
          ],
          "choices": [
            {
              "text": "（病室で）",
              "goto": "c14_5"
            }
          ]
        },
        {
          "id": "c14_5",
          "title": "内なる光",
          "on_enter": [
            "bg('bg/hospital_room.png')"
          ],
          "music": "bgm/daily_calm.mp3",
          "dialogue": [
            {
              "say": "病室の大部屋のほうに、ひとり、来ていた。"
            },
            {
              "say": "そこまで歩いていく力は、もう、なかった。横になったまま、聞いていた。"
            },
            {
              "say": "男の声だった。軽く、そして安定していて、張りつめてもいなければ、緩くもない。"
            },
            {
              "who": "牧原",
              "state": "default",
              "say": "……皆さんが受けておられる苦しみは、無駄に受けているのではありません。苦しみは、門です。それがあなたを敲き開けて、ついに、見えるようにする——その内にいる、本当のあなたを。"
            },
            {
              "who": "牧原",
              "state": "default",
              "say": "その本当のあなたは、ずっと、そこにいた。ただ、古いあなたに、覆われていただけです。"
            },
            {
              "say": "下のほうで、誰かがひとつ、応じた。彼は笑って受け、ゆっくりと、答えていった。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "（……何なの、それは。）"
            },
            {
              "say": "その言葉は、ひとつひとつ聴いていくと、どれも柔らかく、どれも曖昧で、どれも、痛くも痒くもない。たくさん喋って、そして、何ひとつ言っていない。"
            },
            {
              "say": "わたしは幼いころから、社で育った。本当のものが、どういう形をしているかは、知っている。——斎戒、清め、恭敬、ひと句ひと句を誦していく祝詞。それは、分量のあるもの、規矩のあるもの、人が身をもって担いにいくものだ。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "（人を騙している。ひと目で、わかる。）"
            },
            {
              "say": "身を翻して、聴くのを、やめた。"
            }
          ],
          "choices": [
            {
              "text": "（けれど）",
              "goto": "c14_6"
            }
          ]
        },
        {
          "id": "c14_6",
          "title": "叫んでごらん",
          "on_enter": [
            "bg('bg/hospital_room.png')"
          ],
          "dialogue": [
            {
              "say": "その人は、毎日、来た。"
            },
            {
              "say": "はじめは、座って話しているだけだった。三日目に、誰かが、叫ぶのが聞こえた。"
            },
            {
              "who": "牧原",
              "state": "default",
              "say": "——もっと大きく。押さえて言うのなら、それは、古いあなたが、あなたに代わって喋っているのです。"
            },
            {
              "who": "牧原",
              "state": "default",
              "say": "胸のなかで、何を思っているのですか？恐れなくていい。ここには、あなたを咎める人など、いません。叫んでごらんなさい。"
            },
            {
              "say": "はじめは、誰も動かなかった。しばらくして、女の声がひとつ、ごく小さく、何かを言った。"
            },
            {
              "say": "聞き取れない。けれど、続いたのは、ひと連なりの拍手だった。"
            },
            {
              "who": "牧原",
              "state": "default",
              "say": "いい。よく言えました。——それが、あなただ。"
            },
            {
              "say": "二日目、叫ぶ者が、二人に増えた。それからあとは、数えきれなくなった。"
            },
            {
              "say": "何を叫んでいるのかは、これだけ離れていては、はっきりとは聞こえない。ただ、泣いている者がいて、笑っている者がいて、喉が破れるまで叫んで、それでもまだ叫んでいる者がいるのが、わかった。"
            },
            {
              "say": "叫び終えると、いつも、拍手があった。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "（……胸のなかに、あれがある。押さえている。吐き出してしまえば、済むのではないの。）"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "（掻き出して、ひと部屋の人に向かって叫んで、それで宝物あつかいされる。）"
            },
            {
              "say": "布団を、少し高く引き上げた。"
            }
          ],
          "choices": [
            {
              "text": "（そのあと）",
              "goto": "c14_7"
            }
          ]
        },
        {
          "id": "c14_7",
          "title": "わたしも",
          "on_enter": [
            "bg('bg/hospital_room.png')"
          ],
          "dialogue": [
            {
              "say": "十日と経たないうちに、叫ぶ人は、どんどん、思いきりがよくなっていった。"
            },
            {
              "say": "だんだんと、聞き取れるようになった。——彼らは、競っている。"
            },
            {
              "say": "誰がより狠く、誰がより遮らずに言えるか。そういう者が、前へ出る。押さえて言わない者は、古い自分を、まだ剝ぎ落とせていない者だ。"
            },
            {
              "say": "その日の午後、大部屋がふいに静まりかえった。そして、ひとつの声が、ひどく、響いた。"
            },
            {
              "who": "患者",
              "say": "——わたしも、核心承載者になりたい！"
            },
            {
              "say": "呆けた。"
            },
            {
              "say": "続いたのは、拍手だった。これまでのどの一度より、大きかった。"
            },
            {
              "who": "牧原",
              "state": "default",
              "say": "いい。言えましたね。——では、あなたは、なぜそうしないのですか？"
            },
            {
              "who": "患者",
              "say": "わたしも！"
            },
            {
              "who": "患者",
              "say": "わたしもだ！どうして、あの子たちだけができるんだ？"
            },
            {
              "say": "ひと声が、ひと声を継いだ。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "（……核心。）"
            },
            {
              "say": "それは、わたしが幼いころから仰ぎ見てきた場所だ。学校を休み、身体を潰して、ひと足ひと足、行こうとしてきた場所だ。"
            },
            {
              "say": "いま、彼らはそこで、それを叫んでいる。欲しい、と。"
            },
            {
              "say": "夕食のとき、大部屋のほうへ水を汲みに行った。何人かのそばを通ると、彼らはこちらを一瞥して、何も言わなかった。"
            },
            {
              "say": "その目つきに、覚えがあった。——先月、あの教室で、見たことがある。"
            }
          ],
          "choices": [
            {
              "text": "（その日の夜）",
              "goto": "c14_8"
            }
          ]
        },
        {
          "id": "c14_8",
          "title": "夜",
          "on_enter": [
            "bg('bg/hospital_room_night.png')"
          ],
          "music": "bgm/sad_gentle.mp3",
          "dialogue": [
            {
              "say": "その日の夜、量化承載の実験があった。"
            },
            {
              "say": "夜、病室のほうでは、それがまだ、木霊のように響いていた。呻いている者がいる。歯を食いしばっている者がいる。堪えきれずに、泣きだす者がいる。"
            },
            {
              "say": "わたしも、痛い。横たわったまま、動かず、それが過ぎるのを、待っている。"
            },
            {
              "say": "やがて、誰かが、寝台のそばまで、摸ってきた。"
            },
            {
              "who": "患者",
              "say": "……葵お姉ちゃん。"
            },
            {
              "say": "昼間、いちばん大きく叫んでいた、あの人だった。"
            },
            {
              "who": "患者",
              "say": "葵お姉ちゃん、つらい……本当に、つらい……"
            },
            {
              "say": "彼女は寝台のそばにしゃがみこみ、こちらの布団の角を掴んで、泣いた。"
            },
            {
              "say": "身体を横へずらして、手を伸ばし、その頭を、撫でた。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "……知ってる。忍んで。夜が明ければ、少し、ましになるから。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "お水、飲む？わたし、ここにあるよ。"
            },
            {
              "say": "彼女はうなずいて、ふた口飲んだ。まだ、震えていた。"
            },
            {
              "say": "隣に付き添って、しばらく座っていた。彼女が自分の寝台へ戻っていくまで。"
            },
            {
              "say": "病室では、まだ、響いている。横になり直した。"
            },
            {
              "say": "痛みは、まだある。目を閉じて、夜明けを、待った。"
            }
          ],
          "choices": [
            {
              "text": "（第十五章 · 開始）",
              "goto": "c15_1"
            }
          ]
        }
      ]
    }
  ]
}
