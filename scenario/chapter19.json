          "music": "bgm/tension_low.mp3",
          "dialogue": [
            {
              "say": "夜半、腹の痛みで、目が覚めた。"
            },
            {
              "say": "はじめは波のように来ては引いて、まだ、忍べた。身体を丸めて、過ぎるのを、待った。"
            },
            {
              "say": "過ぎて、いかなかった。"
            },
            {
              "say": "捻れは締まるばかりで、全身に、冷たい汗が噴いた。布団の角を噛んで、脚を胸まで、抱えこんだ。"
            },
            {
              "who": "葵",
              "state": "bingfu_pain",
              "say": "（……だめ。お手洗いへ行かないと。）"
            },
            {
              "say": "寝台の縁にすがって、起き上がった。"
            },
            {
              "say": "目の前が暗くなり、また、座りこんだ。"
            },
            {
              "say": "ひと息ついて、もう一度、支えた。今度は、立てた。"
            },
            {
              "say": "寝台の柵につかまって、ひと足ずつ、戸口へ寄っていく。"
            },
            {
              "say": "廊下の灯は、点いていた。戸を押し開けた、そのとき——"
            },
            {
