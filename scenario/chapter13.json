{
  "chapters": [
    {
      "id": "chapter13",
      "title": "例祭",
      "scenes": [
        {
          "id": "c13_1",
          "title": "ひと膜、隔てて",
          "on_enter": [
            "bg('bg/classroom.png')"
          ],
          "music": "bgm/daily_calm.mp3",
          "dialogue": [
            {
              "say": "薬は、効いた。夜は眠れるようになり、金縛りは減り、夢も薄れた。"
            },
            {
              "say": "ただ昼は、いつも、ひと膜を隔てている。"
            },
            {
              "say": "教壇で先生が話している。声は耳に届いていて、ひと文字ひと文字、たしかに聞こえるのに、束ねると、どうしても掬えない。黒板を見つめたまま、ペンは紙の上で止まっていて、ずいぶん経ってから、ひと文字も書いていないことに気づく。"
            },
            {
              "who": "葵",
              "state": "xueshengfu",
              "say": "（さっき……どこまで、話していたの？）"
            },
            {
              "say": "前のページに戻って、糸口を探そうとする。けれど前のページも、白いままだった。"
            },
            {
              "say": "小テストが配られる。問題を見ても、ひとつも解けない。以前なら、目を閉じていても解けた問題だ。"
            },
            {
              "say": "力を尽くして考えようとするのに、頭のなかは綿の塊のようで、押しても動かず、掻き分けることもできない。"
            },
            {
              "who": "葵",
              "state": "xueshengfu",
              "say": "（どうして……たしかに、習ったのに。たしかに、できたのに。）"
            }
          ],
          "choices": [
            {
              "text": "（成績が出た）",
              "goto": "c13_2"
            }
          ]
        },
        {
          "id": "c13_2",
          "title": "ついていけない",
          "on_enter": [
            "bg('bg/classroom.png')"
          ],
          "dialogue": [
            {
              "say": "成績表が配られた日、先生に廊下へ呼ばれた。"
            },
            {
              "who": "教師",
              "say": "白石、この成績は……以前と、あまりに差がありすぎる。体調がよくないのか？このところ授業中もいつも上の空で、ひとこま丸ごと伏せていることもあるだろう。"
            },
            {
              "who": "葵",
              "state": "xueshengfu",
              "say": "すみません。追いつきます。"
            },
            {
              "who": "教師",
              "say": "欠席も多い。このままでは、出席日数も足りなくなる。"
            },
            {
              "say": "うつむいて、ほかに言えることが、なかった。"
            },
            {
              "say": "教室へ戻るとき、少し急ごうとした。"
            },
            {
              "say": "脚が萎えて、そのまま、崩れた。"
            },
            {
              "say": "教科書、筆入れ、成績表が、床に散らばる。膝が床に叩きつけられて、痛みで目の前が白くなった。"
            },
            {
              "who": "葵",
              "state": "xueshengfu",
              "say": "（……立って。立ちなさい。）"
            },
            {
              "say": "床に手をついた。手が、震えている。ひとつ支えて、立てない。もうひとつ支えると、腕が萎えて、また伏せてしまった。"
            },
            {
              "say": "教室が、静かになった。あの視線が、ひと筋ひと筋、背中に落ちてくるのが、わかる。"
            },
            {
              "say": "誰も、助け起こしに来なかった。"
            },
            {
              "say": "そこに伏せたまま、頬を床につけて、喘いでいた。"
            },
            {
              "who": "葵",
              "state": "xueshengfu_cry",
              "say": "（……どうして。どうして、立つことすら、できなくなったの。）"
            },
            {
              "say": "ずいぶん経って、先生が駆けつけて、わたしを保健室へ連れていった。"
            },
            {
              "say": "その道すがら、ひと度も、顔を上げなかった。"
            }
          ],
          "choices": [
            {
              "text": "（週末、病院）",
              "goto": "c13_x"
            }
          ]
        },
        {
          "id": "c13_x",
          "title": "提案",
          "on_enter": [
            "bg('bg/kensa_room.png')"
          ],
          "dialogue": [
            {
              "say": "週末、病院へ行って、学校のことを話した。倒れたこと、起き上がれなかったこと、問題がひとつも解けないこと。"
            },
            {
              "say": "藤崎医師は聴きながら、ノートを繰り、うなずいていた。"
            },
            {
              "who": "藤崎",
              "state": "default",
              "say": "ええ、これは想定の内です。鎮静系の薬は、認知の面にたしかに影響します——反応が遅くなる、注意が散る、覚えられない。どれも、よくあることです。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "それなら……お薬を、減らせませんか？学校の勉強に、追いつきたいんです。"
            },
            {
              "who": "藤崎",
              "state": "default",
              "say": "薬を減らせば、睡眠が抑えられなくなる。今のその身体で、眠れないというのは、大事につながります。どちらが軽く、どちらが重いか。あなたなら、わかるはずだ。"
            },
            {
              "say": "彼はペンを置き、身体を後ろへ預けた。もう考え抜いてある事柄を、これから言おうとするかのように。"
            },
            {
              "who": "藤崎",
              "state": "default",
              "say": "私の提案は——休学です。"
            },
            {
              "say": "顔を、上げた。"
            },
            {
              "who": "藤崎",
              "state": "default",
              "say": "今のあなたの状態で、無理に学校へ行っても、授業は入らない、試験はできない、身体はますます削れていく。割に合いません。それより、この期間を空けて、心置きなく身体を治すべきだ。"
            },
            {
              "who": "藤崎",
              "state": "default",
              "say": "学籍は残ります。治ってから戻ればいい。同じことです。これが、あなたにとって最善の手配です。"
            },
            {
              "say": "彼の言うことには、筋が通っていた。ひと言も、返せなかった。"
            },
            {
              "say": "教室の床に伏せて、二度支えても立ち上がれなかった自分を思い出す。解けなかった、あの問題たちを思い出す。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "（……その通りだ。今のわたしでは、行っても、行かないのと同じ。）"
            },
            {
              "say": "そのとき、新田が戸口から顔を覗かせた。ちょうど通りかかった、というふうに。"
            },
            {
              "who": "新田",
              "state": "default",
              "say": "失礼。休学の話ですか。"
            },
            {
              "say": "彼は入ってきて、かたわらに腰を下ろした。"
            },
            {
              "who": "新田",
              "state": "default",
              "say": "白石さん、実のあることを申し上げます。勉強が遅れるのは、たしかに惜しい。——ですがこの世に、成績のよい人間は、いくらでもいる。"
            },
            {
              "who": "新田",
              "state": "default",
              "say": "承載できる人間は、多くありません。"
            },
            {
              "say": "言葉に、詰まった。"
            },
            {
              "who": "新田",
              "state": "default",
              "say": "計画は、次の段で拡大します。受ける人はもっと増え、することももっと増える。そのとき我々がいちばん欠くのは、皆さんのような人だ。"
            },
            {
              "who": "新田",
              "state": "default",
              "say": "教科書の中身は、誰でも学べる。あなたが一年遅れて読んでも、同じことです。しかし、あなたたちが身に宿しているものは、他人には学べない。これは、本当のことです。"
            },
            {
              "say": "彼はごく平らかに語った。誰にでもわかる道理を、説いてみせるように。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "（……成績のよい人は、多い。承載できる人は、少ない。）"
            },
            {
              "say": "その二句を、胸のなかで、ひと巡りさせてみた。"
            },
            {
              "say": "教室で逸れていった、あの目を思い出す。床に伏せて、誰も助けに来なかった自分を思い出す。あの教室で、わたしは、何者でもなかった。"
            },
            {
              "say": "けれどここでは、この人たちが、わたしを必要としている。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "（……そうだ。学校のほうは、わたしひとり欠けても、困りはしない。でも、こちらは……）"
            },
            {
              "who": "新田",
              "state": "default",
              "say": "もちろん、これはあなた自身の選択です。強いはしません。"
            },
            {
              "who": "藤崎",
              "state": "default",
              "say": "得心がいったなら、それでいい。手続きは難しくありません。学校には、医師の指示に従うのだと、はっきり伝えてください。"
            },
            {
              "say": "彼はノートを閉じて、ひとつ、笑った。"
            },
            {
              "who": "藤崎",
              "state": "default",
              "say": "こうすれば時間にも余裕ができる。週末のこちらの用も、慌ただしく行き来せずに済みますね。"
            },
            {
              "say": "うなずいた。"
            },
            {
              "say": "結菜と咲のほうも、医師の出した提案は、同じだった。"
            }
          ],
          "choices": [
            {
              "text": "（手続き）",
              "goto": "c13_3"
            }
          ]
        },
        {
          "id": "c13_3",
          "title": "休学",
          "on_enter": [
            "bg('bg/classroom.png')"
          ],
          "music": "bgm/sad_gentle.mp3",
          "dialogue": [
            {
              "say": "手続きは、ごく平凡に済んだ。"
            },
            {
              "say": "一枚の用紙、いくつかの署名。先生がひとつ息を吐いて、判を捺した。"
            },
            {
              "who": "教師",
              "say": "……まずは、身体を治しなさい。学校は空けておく。よくなったら、いつでも戻ってきなさい。"
            },
            {
              "who": "葵",
              "state": "xueshengfu",
              "say": "はい。ありがとうございました。"
            },
            {
              "say": "最後に、あの教室から出た。誰も顔を上げず、誰も、見送らなかった。"
            },
            {
              "say": "麻衣は窓ぎわに座って、戸に背を向けていた。戸口でしばらく立っていたけれど、結局は、行った。"
            },
            {
              "say": "週末、病院で顔を合わせて、結菜と咲のほうも、同じだと知った。"
            },
            {
              "say": "三人が三つの学校で、誰も、誰がどう最後まで踏ん張ったのかを、見ていなかった。それでも事ここに至れば、踏み出したのは、同じひと足だった。"
            },
            {
              "who": "結菜",
              "state": "bingfu",
              "say": "うちの担任なんて、もう一学期は踏ん張れって言うんだよ。もう、無理だってば。"
            },
            {
              "say": "軽やかに、笑って言った。目のふちだけが、赤かった。"
            },
            {
              "who": "咲",
              "state": "bingfu",
              "say": "……わたしも、出した。"
            },
            {
              "say": "誰も、応えなかった。"
            },
            {
              "say": "制服は畳んで、簞笥にしまった。翌朝からは、止める目覚ましが、なかった。"
            }
          ],
          "choices": [
            {
              "text": "（社のほう）",
              "goto": "c13_4"
            }
          ]
        },
        {
          "id": "c13_4",
          "title": "他社の巫女",
          "on_enter": [
            "bg('bg/shamusho_guests.png')"
          ],
          "dialogue": [
            {
              "say": "例祭の日が近づいた。"
            },
            {
              "say": "まだ、踏ん張ってはいた。社の仕事は、できる分だけこなす。けれど承載の力については、自分がいちばんよくわかっている。——今のわたしでは、受け止められない。"
            },
            {
              "say": "その日、社へ行くと、宮司は社務所で、一通の書状を前に、座っていた。"
            },
            {
              "who": "宮司",
              "say": "……葵。来たか。"
            },
            {
              "say": "彼はその書状を脇へ押しやった。見せたくない、というふうに。"
            },
            {
              "who": "宮司",
              "say": "例祭の件は、決めた。隣郡の社に頼んで、あちらの巫女に来てもらい、承載を助けてもらう。"
            },
            {
              "say": "そこに立ったまま、しばらく、意味が呑みこめなかった。"
            },
            {
              "who": "葵",
              "state": "pain",
              "say": "……他社の、巫女？"
            },
            {
              "who": "宮司",
              "say": "うむ。来てくださるだけで、顔を立ててもろうたことになる。体裁のよい話ではないが、今は、ほかに手立てがない。"
            },
            {
              "say": "老人の声は、ごく平らかだった。ありふれた公事を語るように。——けれど、膝に置かれたその手の、指の節が、白くなっているのが見えた。"
            },
            {
              "who": "宮司",
              "say": "お前たち三人の身体が、大事だ。例祭は毎年ある。人は、ひとりしかおらん。"
            },
            {
              "say": "口を、開きかけた。"
            },
            {
              "say": "「わたしにできます」と、言いたかった。この言葉を、幾度も口にしてきた。そして幾度も、最後まで踏ん張ってきた。"
            },
            {
              "say": "けれど今度ばかりは、小テストの、解けなかった問題たちを思い出した。階段を上るときの、震える脚を思い出した。負載のあと、幾日も床に下りられなかった自分を思い出した。"
            },
            {
              "say": "その言葉を、呑みくだした。"
            },
            {
              "who": "葵",
              "state": "pain",
              "say": "……はい。ご迷惑を、おかけします。"
            },
            {
              "say": "宮司はそれ以上、何も言わなかった。ただ手を上げて、そっと、わたしの肩を押さえた。"
            },
            {
              "say": "社務所を出て、参道に、長いこと立っていた。"
            },
            {
              "who": "葵",
              "state": "pain",
              "say": "（わたしがずっと踏ん張ってきたのは、例祭のためではなかったの。）"
            },
            {
              "who": "葵",
              "state": "pain",
              "say": "（学校も休んだ。身体も潰れた。それで結局、例祭は、他人が来て務める。）"
            },
            {
              "say": "風が鳥居を抜けて、注連縄の紙垂を、がさがさと鳴らしていった。"
            },
            {
              "say": "例祭の日、わたしは、行かなかった。"
            }
          ],
          "choices": [
            {
              "text": "（第十四章 · 開始）",
              "goto": "c14_1"
            }
          ]
        }
      ]
    }
  ]
}
