            {
              "say": "彼は、たいへんありふれた口ぶりで言った。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "この道は、何百年も、探してきた。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "ひと世代に、幾人か出るだけだ。"
            },
            {
              "say": "彼は、顔を上げた。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "この一代のぶんは、みな、この建物のなかにいる。"
            },
            {
              "say": "検査室は、たいへん静かだった。"
            },
            {
              "say": "わたしは、壁ぎわの椅子に座っていた。"
            },
            {
              "say": "算していた。"
            },
            {
              "say": "咲のほうは、この陣は、いくらか調子がよい。"
            },
            {
              "say": "こちらは、ちょうど、養われたばかりだ。"
            },
            {
              "say": "帳面を、開いた。"
            }
