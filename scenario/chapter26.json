              "who": "鹿島",
              "state": "default",
              "say": "見えなければ、記されん。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "記されなければ、無かったことになる。"
            },
            {
              "say": "間瀬の、顔色が変わった。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "この一年の帳は、欠けている。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "ずっと、欠けている。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "欠けた分は、帳の上にはない。人の身の上にある。"
            },
            {
              "say": "彼は、屏幕を、消した。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "指標というのは、この子たちの身体を凑めて作ったものだ。"
            },
            {
              "say": "検査室は、たいへん静かだった。"
            },
            {
              "say": "わたしは、そこに立っていた。"
            },
            {
              "say": "よく、聞き取れなかった。"
