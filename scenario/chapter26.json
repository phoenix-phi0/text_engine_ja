            {
              "say": "彼の手は、袖のなかに、差しこまれていた。"
            },
            {
              "who": "早坂",
              "state": "default",
              "say": "皆さん、よくご協力を。"
            },
            {
              "say": "仁科は、右に立っていた。"
            },
            {
              "say": "彼は、何も言わなかった。"
            },
            {
              "say": "彼は、見ていた。"
            },
            {
              "say": "左から右へ、見ていく。"
            },
            {
              "say": "たいへん、ゆっくりと。"
            },
            {
              "say": "散会したあと、鹿島がひとり、検査室で、長いこと待っていた。"
