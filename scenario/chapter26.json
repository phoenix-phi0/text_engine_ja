              "who": "葵",
              "state": "bingfu",
              "say": "……では、わたしたちのこの一年は、無駄に働いた、ということですか。"
            },
            {
              "say": "鹿島は、こちらを見ていた。"
            },
            {
              "say": "彼は、答えなかった。"
            },
            {
              "say": "当番表を、机の上に置いた。"
            },
            {
              "who": "葵",
              "state": "bingfu_calm",
              "say": "来週の分です。"
            },
            {
              "who": "葵",
              "state": "bingfu_calm",
              "say": "わたしに、ひと段、足しました。"
            },
            {
              "say": "礼をして、出ていった。"
            }
          ],
