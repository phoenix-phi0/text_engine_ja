              "who": "飼部",
              "state": "default",
              "say": "以上。"
            },
            {
              "say": "彼は、退がった。"
            },
            {
              "say": "早坂が、彼の左に立っていた。"
            },
            {
              "say": "彼は、下を向いて、ひとつ笑った。"
            },
            {
              "who": "早坂",
              "state": "default",
              "say": "この陣は、皆さんに、ご苦労をかけますね。"
