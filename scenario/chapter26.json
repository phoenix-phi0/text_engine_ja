{
  "chapters": [
    {
      "id": "chapter26",
      "title": "人が替わった",
      "scenes": [
        {
          "id": "c26_1",
          "title": "人が替わった",
          "on_enter": [
            "bg('bg/hospital_corridor.png')"
          ],
          "music": null,
          "dialogue": [
            {
              "who": "間瀬",
              "state": "default",
              "say": "今週、あなたたちが離れたあと、核心のほうの事務は、別の者に渡されました。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "毎日、波形は検めていた。異常は、見つからなかった。"
            },
            {
              "say": "彼は、その紙の束を、握りしめていた。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "抽出の数値が合わないと気づくまでは。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "病室を、検めに行きました。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "なかの人が、もう、替わっていた。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "波形は、偽造です。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "鹿島さん、どうします。"
            },
            {
              "say": "鹿島は、こちらの後ろに立っていた。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "なぜ、こんなことになる。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "新田は、何と言っている。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "……新田は、口を濁しています。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "上級の要請だ、と。"
            },
            {
              "who": "樋口",
              "state": "default",
              "say": "どこへ移した。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "……わかりません。"
            },
            {
              "say": "森下は、いちばん後ろに立っていた。"
            },
            {
              "who": "森下",
              "state": "default",
              "say": "謀られました。"
            },
            {
              "who": "森下",
              "state": "default",
              "say": "調虎離山です。"
            },
            {
              "say": "……"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "直に上へ行って、人を返せと言う。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "しかし、どうやって……"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "手がなければ、手を考えるんだ！"
            },
            {
              "say": "その声は、たいへん、大きかった。"
            },
            {
              "say": "彼のこんな姿を、見たことがなかった。"
            }
          ],
          "choices": [
            {
              "text": "（結城）",
              "goto": "c26_2"
            }
          ]
        },
        {
          "id": "c26_2",
          "title": "六選",
          "on_enter": [
            "bg('bg/shamusho_eaves.png')"
          ],
          "music": "bgm/tension_low.mp3",
          "dialogue": [
            {
              "say": "結城を、訪ねた。"
            },
            {
              "who": "結城",
              "say": "神保が、六選した。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "……あの、汚職事件の神保、ですか？"
            },
            {
              "say": "結城は、答えなかった。"
            },
            {
              "who": "結城",
              "say": "……この世界は、狂っているのか。"
            },
            {
              "say": "何も、言わなかった。"
            },
            {
              "say": "何を言えばいいのか、わからなかった。"
            }
          ],
          "choices": [
            {
              "text": "（翌日）",
              "goto": "c26_3"
            }
          ]
        },
        {
          "id": "c26_3",
          "title": "支える",
          "on_enter": [
            "bg('bg/lab_room.png')"
          ],
          "music": "bgm/tension_low.mp3",
          "dialogue": [
            {
              "say": "翌日、柊会が、人を検査室へ呼び集めた。"
            },
            {
              "say": "鹿島が、機器の読みを指して、見せた。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "まだ、腐っている。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "わたしたちが封じたところが、日に日に、ゆるむ。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "底から、何かが、ずっと突き上げてくる。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "……防げないのですか。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "防げん。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "これを防ぐには、人が要る。承載者が要る。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "核心のあの五人は、もともと、それを為すためのものだ。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "いまは、誰もいない。"
            },
            {
              "say": "彼は、袖をまくり上げた。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "まず、わたしたちで支える。"
            },
            {
              "who": "樋口",
              "state": "default",
              "say": "……わたしたちは、承載者ではない。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "わかっている。"
            },
            {
              "say": "樋口は、しばらく彼を見ていた。"
            },
            {
              "say": "彼も、袖をまくり上げた。"
            },
            {
              "say": "森下はかたわらに立って、ひと言も、言わなかった。"
            },
            {
              "say": "彼は、上衣を脱いだ。"
            },
            {
              "say": "三人が、台に上がった。"
            },
            {
              "say": "その日、彼らはたいへん遅くまで、やった。"
            },
            {
              "say": "出てきたとき、鹿島の顔は、白かった。"
            },
            {
              "say": "樋口は、壁にすがっていた。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "何日も、支えられん。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "わたしたちは、その器ではない。"
            },
            {
              "say": "彼は、腰を下ろした。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "眼下、支えられる容器は、白石さんと、あの咲さんだけだ。"
            },
            {
              "say": "結城が、立ち上がった。"
            },
            {
              "who": "結城",
              "say": "新しいほうは、どうです。"
            },
            {
              "who": "結城",
              "say": "火稲計画で篩い出した六人、もう手をつけているのでは。"
            },
            {
              "say": "鹿島は、首を振った。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "遠く、及ばん。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "あの子たちが受け止められるのは、抽出だ。抽出は、抽出でしかない。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "これを支えるのは、別のことだ。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "通道が、広くなければならん。持ちこたえられねばならん。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "あの子たちを上げれば、ひと晩で、廃になる。"
            },
            {
              "say": "結城は、そこに立っていた。"
            },
            {
              "who": "結城",
              "say": "……外は、どうです。"
            },
            {
              "who": "結城",
              "say": "生まれつき、それができる者は。"
            },
            {
              "who": "結城",
              "say": "そのまま連れてきて、使える者は。"
            },
            {
              "say": "鹿島は、彼をひと目、見た。"
            },
            {
              "who": "鹿島",
              "state": "default",
              "say": "いる。"
            },
            {
              "say": "結城が、ひと足、前へ出た。"
