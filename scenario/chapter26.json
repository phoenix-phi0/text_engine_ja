            },
            {
              "who": "飼部",
              "state": "default",
              "say": "人手は足りている。設備も、足りている。"
            },
            {
              "say": "彼は、たいへんありふれた口ぶりで言った。"
            },
            {
              "who": "飼部",
              "state": "default",
              "say": "流程は、これまでと同じです。"
            },
