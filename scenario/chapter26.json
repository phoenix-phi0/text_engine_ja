          ],
          "music": "bgm/daily_calm.mp3",
          "dialogue": [
            {
              "say": "三日目、大部屋に、ひと枚の通知が貼り出された。"
            },
            {
              "say": "堀田が、ひと通り、読み上げた。"
            },
            {
              "who": "堀田",
              "state": "default",
              "say": "負載承接体制の調整について。"
            },
