          "dialogue": [
            { "say": "全員があなたを見ていた。" },
            { "who": "鹿島", "state": "default", "say": "白石さん。これはあんた自身がうなずかないと始まらない。" },
            { "who": "鹿島", "state": "default", "say": "よく考えてから答えろ。" },
            { "say": "あなたはそこに座っていた。" },
            { "say": "少し、考えた。" },
            { "who": "葵", "state": "bingfu_calm", "say": "やります。" },
