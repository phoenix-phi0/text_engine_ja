            { "say": "傍らでヴォスさんが何か言い、通訳が伝えてきた。" },
            { "who": "Voss", "state": "default", "say": "我々は良質な生理データをまとまった量、必要としている。君が最適だ。" },
            { "say": "彼はひどく興奮していた。" },
            { "who": "Voss", "state": "default", "say": "君の信号は、この二十年で見た中で最もクリーンだ。" },
            { "say": "隅にいた若い外国人の女が一度顔を上げ、また伏せた。" },
            { "who": "葵", "state": "bingfu", "say": "……何をするんですか。" },
            { "who": "新田", "state": "default", "say": "横になるだけです。" },
            { "say": "彼は紙の束を開いた。" },
            { "who": "新田", "state": "default", "say": "音をいくつか流し、明かりを何度か点ける。あなたは何もしなくていい。" },
            { "who": "新田", "state": "default", "say": "我々はあなたの反応を記録します。" },
            { "who": "葵", "state": "bingfu", "say": "……それだけ?" },
