            { "who": "葵", "state": "bingfu_calm", "say": "私の通路が支えきれないことは、分かっています。" },
            { "who": "葵", "state": "bingfu_calm", "say": "でも核心のほうが切れたら、それまでの全部が無駄になる。" },
            { "who": "葵", "state": "bingfu_calm", "say": "それは、いけません。" },
            { "say": "あなたは早口でそう言った。" },
            { "say": "鹿島さんがうなずいた。" },
            { "who": "鹿島", "state": "default", "say": "よし。" },
            { "who": "鹿島", "state": "default", "say": "なら今日から、養ってもらう。" },
            { "who": "葵", "state": "bingfu", "say": "……養う?" },
            { "who": "鹿島", "state": "default", "say": "負荷は最低まで落とす。抽取は週に一回を超えないこと。" },
            { "who": "鹿島", "state": "default", "say": "食え。寝ろ。歩け。眠れるなら眠れ。" },
            { "who": "鹿島", "state": "default", "say": "封と注入は続ける。これは止めない。" },
            { "say": "彼は立ち上がり、道具をしまい始めた。" },
            { "who": "鹿島", "state": "default", "say": "予備バッテリーが空っぽじゃ、予備の意味がないだろう。" },
            { "say": "彼は気安い調子でそう言った。" },
            { "say": "彼は出て行った。樋口さんも続いて出て行った。" },
            { "say": "森下さんは戸口まで行って、振り返った。" },
            { "who": "森下", "state": "default", "say": "白石さん。" },
            { "who": "森下", "state": "default", "say": "この期間、できるだけ支え戻します。" },
            { "who": "森下", "state": "default", "say": "一分でも、支えられるだけ。" },
            { "say": "彼は一礼した。" },
            { "who": "森下", "state": "default", "say": "全力を尽くします。" },
            { "say": "彼も出て行った。" },
            { "say": "部屋には、あなたと結城さんだけが残った。" },
            { "say": "彼は扉の脇に立ったまま、ずっと動かなかった。" },
            { "who": "結城", "say": "……白石さん。" },
            { "who": "結城", "say": "さっきの「やります」だが。" },
            { "who": "結城", "say": "考えもしなかっただろう。" },
            { "say": "あなたは顔を上げた。" },
            { "who": "葵", "state": "bingfu", "say": "……考えました。" },
            { "who": "葵", "state": "bingfu", "say": "このところ、ずいぶん良くなったんです。頭もそんなに痛くないし、身体も戻ってきています。" },
            { "who": "葵", "state": "bingfu", "say": "それに、養えと言われました。" },
            { "who": "葵", "state": "bingfu", "say": "負荷は最低まで、抽取は週に一回だけ。" },
            { "say": "そこまで言って、あなたは一度、言葉を切った。" },
            { "who": "葵", "state": "bingfu", "say": "そうなると、私の組の負荷を誰かが分けなければなりません。" },
            { "who": "葵", "state": "bingfu", "say": "割り当てを組み直してきます。" },
            { "say": "あなたは立ち上がり、彼に一礼した。" },
            { "say": "そして、出て行った。" },
            { "say": "結城さんは、その場に立っていた。" },
            { "say": "廊下には、誰もいなかった。" }
          ],
          "choices": [
            { "text": "（負荷を下げる）", "goto": "c24_4" }
          ]
        },
        {
