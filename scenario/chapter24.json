{
  "chapters": [
    {
      "id": "chapter24",
      "title": "予備",
      "scenes": [
        {
          "id": "c24_1",
          "title": "調べ終わった",
          "on_enter": [
            "bg('bg/lab_room.png')"
          ],
          "music": "bgm/tension_low.mp3",
          "dialogue": [
            { "say": "柊会は三週間かけて調べた。" },
            { "say": "人だけではない。リンク一式を、端から端まで一度洗い直した。" },
            { "say": "その日、彼らはあなたを検査室に呼んだ。" },
            { "say": "三人とも揃っていた。結城さんもいる。扉の脇に立っていた。" },
            { "say": "鹿島さんが書類の束を机に置いた。開きはしなかった。" },
            { "who": "鹿島", "state": "default", "say": "白石さん、座って。" },
            { "say": "あなたは腰を下ろした。" },
            { "who": "鹿島", "state": "default", "say": "調べ終わった。一応、伝えておく。" },
            { "say": "彼は背もたれに寄りかかった。" },
            { "who": "鹿島", "state": "default", "say": "あんたたち個人の問題じゃない。" },
            { "who": "鹿島", "state": "default", "say": "このリンクそのものだ。" },
            { "say": "彼は顎をしゃくって、機器を、台を、配線を示した。" },
            { "who": "鹿島", "state": "default", "say": "土台が腐ってる。思ってたより深くな。" },
            { "who": "鹿島", "state": "default", "say": "あんたたちはその上に繋がれてる。土台が腐れば、あんたたちも腐る。" },
            { "who": "鹿島", "state": "default", "say": "封じることはできる。だが封じたところが緩む。注ぎ込んだものも、数日で抜ける。" },
            { "who": "鹿島", "state": "default", "say": "このままなら、ずっとやり続けるしかない。人がいなくなるまでな。" },
            { "say": "彼はごく当たり前のことのように言った。" },
            { "who": "結城", "say": "……では、どうすれば。" },
            { "say": "結城さんの声は低かった。" },
            { "who": "鹿島", "state": "default", "say": "再構築だ。" },
            { "who": "鹿島", "state": "default", "say": "リンク全体を一気に押し流して、通し直す。" },
            { "who": "鹿島", "state": "default", "say": "腐ったところを洗い流して、もう一度形を定める。" },
            { "say": "樋口さんは脇に立ったまま、一言も発しない。" },
            { "who": "結城", "say": "どうやって流す。" },
            { "who": "鹿島", "state": "default", "say": "ピーク抽出だ。" }
          ],
          "choices": [
            { "text": "（ピーク）", "goto": "c24_2" }
          ]
        },
        {
          "id": "c24_2",
          "title": "予備バッテリー",
          "on_enter": [
            "bg('bg/lab_room.png')"
          ],
          "dialogue": [
            { "who": "鹿島", "state": "default", "say": "一度で天井まで抽く。核心の通路を全開にする。" },
            { "who": "鹿島", "state": "default", "say": "同時に地脈を流し込む。量は多いほどいい。" },
            { "who": "鹿島", "state": "default", "say": "押し流して、形を定め直す。これを一度通せば、リンクは新品になる。" },
            { "say": "結城さんの手が戸枠にかかった。" },
            { "who": "結城", "say": "……その量に、人は耐えられるのか。" },
            { "who": "鹿島", "state": "default", "say": "通路が十分に広ければ、通る。" },
            { "say": "彼はあなたを一瞥した。" },
            { "who": "鹿島", "state": "default", "say": "足りなければ、焼ける。" },
            { "say": "そこで森下さんが口を開いた。" },
            { "who": "森下", "state": "default", "say": "白石さんの通路は、この数週間ずっと私が修復しています。" },
            { "who": "森下", "state": "default", "say": "素質は良い。深いです。" },
            { "say": "彼は一度、間を置いた。" },
            { "who": "森下", "state": "default", "say": "ですが、使われすぎている。" },
            { "who": "森下", "state": "default", "say": "ずっと抽かれ続けて、休んだことがない。支えきれません。" },
            { "say": "彼はとても真面目に言った。彼はいつも真面目だった。" },
            { "who": "森下", "state": "default", "say": "私が下から支え戻しています。" },
            { "who": "森下", "state": "default", "say": "どこまで戻せるかは、何とも言えません。" },
            { "say": "鹿島さんがうなずいた。" },
            { "who": "鹿島", "state": "default", "say": "だから主力は核心の五人だ。あそこの通路が一番広い。" },
            { "who": "鹿島", "state": "default", "say": "白石さんは予備だ。" },
            { "who": "結城", "say": "予備とは、どういう意味だ。" },
            { "who": "鹿島", "state": "default", "say": "予備バッテリーだ。" },
            { "say": "彼はごく軽い口調で言った。" },
            { "who": "鹿島", "state": "default", "say": "核心のほうが落ちたら、誰かが繋がなきゃならん。切らすわけにいかない。" },
            { "who": "鹿島", "state": "default", "say": "一度切れれば、それまでの全部が無駄になる。" },
            { "who": "結城", "say": "……彼女の通路は、支えきれない。" },
            { "who": "結城", "say": "あんた自身がさっきそう言った。足りなければ焼ける、と。" },
            { "who": "鹿島", "state": "default", "say": "ああ。" },
            { "say": "彼はあっさりと答えた。" },
            { "who": "鹿島", "state": "default", "say": "だから養う。ピークの日まで、広げられるだけ広げる。" },
            { "who": "鹿島", "state": "default", "say": "使わずに済めば、それが一番いい。" },
            { "say": "結城さんは、それ以上何も言わなかった。" }
          ],
          "choices": [
            { "text": "（葵）", "goto": "c24_3" }
          ]
        },
        {
