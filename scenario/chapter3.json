{
  "chapters": [
    {
      "id": "chapter3",
      "title": "もう少しだけ担ぐ",
      "scenes": [
        {
          "id": "c3_1",
          "title": "空いた席",
          "on_enter": [
            "bg('bg/haiden.png')"
          ],
          "music": "bgm/daily_calm.mp3",
          "dialogue": [
            {
              "say": "秋祭から幾日か過ぎた。日々は、変わらず流れていく。"
            },
            {
              "say": "神楽の奉納は、承載のうちでも最も重く、最も荘厳なもの。けれどそれは、たまにしかない。ふだんの日々にわたしたちがしているのは、こまごまとした仕事だ。"
            },
            {
              "say": "早朝の落ち葉掃き、社殿の拭き掃除、神饌の支度、御朱印を書き、授与所で御守や御札を授ける。"
            },
            {
              "say": "今このときも、授与所に座って、賽銭箱のお賽銭を一枚ずつ数えている。"
            },
            {
              "who": "結菜",
              "state": "calm",
              "say": "こんなにあるのに一枚ずつなんて、目がちかちかしてくるよ。"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "でもこのお金は、昔から自分たちの手で数えるものでしょう。"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "考えてみて。この一枚一枚に、箱へ投げ入れたときの願いが乗っているの。機械に冷たく通して済ませるわけには、いかないでしょう。"
            },
            {
              "say": "これも承載だ。舞だけではない。——掃いた地面、数えた銭、手を通したひとつひとつの事のなかに、承け、皆に代わって神前へ捧げるべきものが、宿っている。"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（きちんと数える。間違えないように。神様が、見ておられる。）"
            },
            {
              "say": "とてもゆっくり、丁寧に数えていく。指先が、ひんやりとした硬貨をひとつずつ撫でていく。会ったこともない誰かの祈りを、撫でるように。"
            },
            {
              "say": "そのとき、ふと、小さなことを思い出した。"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "そういえば……美和さん、今日も来ていないの？"
            },
            {
              "say": "美和は隣町の社の巫女で、わたしたちより幾つか年上だった。以前はよく一緒に奉納をし、一緒に笑った。ここのところ、ずっと姿を見ない。"
            },
            {
              "who": "結菜",
              "state": "calm",
              "say": "体調がよくなくて、家で休んでるって聞いたよ。ちょっと前には静香さんも、やっぱり……"
            },
            {
              "who": "咲",
              "state": "calm",
              "say": "（……見知った顔が、何人も、来なくなった。）"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "体調が悪いのなら……しっかり養生しないと。よくなったら、また一緒に舞いましょう。"
            },
            {
              "say": "そう言いながら数え終えた銭を揃える。胸の底の小さな寂しさは、尽きることのない仕事に、すぐ覆い隠されてしまった。"
            },
            {
              "say": "ただ、気づかなかった。——空いた席が、一つ、また一つと、埋まらなくなっていたことに。"
            }
          ],
          "choices": [
            {
              "text": "日常へ戻る",
              "goto": "c3_2"
            }
          ]
        },
        {
          "id": "c3_2",
          "title": "宮司の憂い",
          "on_enter": [
            "bg('bg/shamusho_eaves.png')"
          ],
          "dialogue": [
            {
              "say": "このごろ、宮司の眉根はいつも寄っている。"
            },
            {
              "say": "社務所でひとり、書類の束を前に、じっと動かずにいるところに出くわした。"
            },
            {
              "who": "宮司",
              "say": "……人手が、年ごとに細くなっていく。昔とは違うのう。"
            },
            {
              "say": "独り言のようでもあり、わたしに聞かせているようでもあった。こちらに気づくと、彼は無理に笑って、書類を閉じた。"
            },
            {
              "who": "宮司",
              "say": "近ごろは何でも測る、計る、数にして書き留める……老いぼれには、ついていけんわ。"
            },
            {
              "who": "宮司",
              "say": "葵。お前たちは、ただ、きちんと舞えばよい。あとのことは、わしと結城さんが担う。"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（宮司は、何か気がかりがあるみたい。……でも、いつも「舞うことだけ考えなさい」と言う。）"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "はい！ご安心ください。わたしたち、きちんと舞います。"
            },
            {
              "say": "彼はうなずいた。それでも目の奥には、晴れない憂いが残っていた。わたしには、それが読めなかった。"
            }
          ],
          "choices": [
            {
              "text": "（宮司は、何を案じているのだろう）",
              "goto": "c3_3"
            }
          ]
        },
        {
          "id": "c3_3",
          "title": "未来を織る者",
          "on_enter": [
            "bg('bg/shamusho_guests.png')"
          ],
          "music": "bgm/festival_solemn.mp3",
          "dialogue": [
            {
              "say": "数日後、間宮がわたしたちを集め、あらたまって大きな話を告げた。"
            },
            {
              "who": "間宮",
              "say": "皆さん。今日は、ある……素晴らしい計画をご紹介したいのです。"
            },
            {
              "say": "その目は輝いていた。声には、隠しようのない熱があった。"
            },
            {
              "who": "間宮",
              "say": "その名を、《未来を織る者》と申します。"
            },
            {
              "who": "間宮",
              "say": "これは前例のない交差計画です。——最先端の量子技術と人工知能を、皆さんが千年守ってこられた伝統の承載と、結びつける。"
            },
            {
              "who": "間宮",
              "say": "皆さんの承載は、あまりに貴重で、そしてあまりに……古い。口伝と身伝だけに頼っていては、いずれ必ず失われます。しかし科学によって記録し、解析し、発展させることができれば——それは永く受け継がれ、より多くの人を救うことになる。"
            },
            {
              "who": "間宮",
              "say": "皆さんは、もはやただの巫女ではありません。その手で未来を織りあげる者——名実ともに、未来を織る者なのです。"
            },
            {
              "who": "結菜",
              "state": "laugh",
              "say": "未来を織る……！なんかすごい！"
            },
            {
              "who": "咲",
              "state": "laugh",
              "say": "（わたしたちのしてきたことが……こんなに重く、受け継がれていく。）"
            },
            {
              "who": "葵",
              "state": "laugh",
              "say": "（最先端の技術で、わたしたちの承載を未来へ運んで、もっと多くの人を助ける……）"
            },
            {
              "who": "葵",
              "state": "laugh",
              "say": "（こんな大きなことに加われるなんて、わたしは……とても、光栄だ。）"
            },
            {
              "say": "結城が間宮のかたわらで、重々しくうなずき、この計画に裏書きを与えた。疑う理由など、どこにもなかった。——これは明らかに、これ以上ないほど、よい話だった。"
            }
          ],
          "choices": [
            {
              "text": "参加させてください",
              "goto": "c3_4"
            }
          ]
        },
        {
          "id": "c3_4",
          "title": "算び出された数字",
          "on_enter": [
            "bg('bg/kensa_room.png')"
          ],
          "dialogue": [
            {
              "say": "《未来を織る者》が動き出して、まず行われたのは、わたしたちの承載を、目に見えるものに変えることだった。"
            },
            {
              "say": "検査は馴染んだもの——心拍、脳波、それに葉月医師のやわらかな問診。ただ今回は、その数値が、わたしたちには読めない機械へ送り込まれていった。"
            },
            {
              "who": "間宮",
              "say": "素晴らしい。量子とAIの解析によって、我々はついに、皆さんの一度ごとの承載の量を……正確に測ることができるようになりました。"
            },
            {
              "say": "画面に数字と曲線が次々と現れる。間宮はそれを、宝でも見るように見ていた。"
            },
            {
              "who": "結城",
              "say": "白石さん。計測によれば、お三方のうち、あなたの承載量が……最も高い。他を大きく上回っています。"
            },
            {
              "who": "葵",
              "state": "laugh",
              "say": "（最も高い……わたしの量が、いちばん高い！）"
            },
            {
              "who": "間宮",
              "say": "そして今、承載できる者は減り続けています。欠けた分は、誰かが埋めねばならない。これは誰かが皆さんに無理を強いているのではありません。——モデルが算び出した、必要な調整なのです。"
            },
            {
              "who": "結城",
              "say": "しばらくのあいだ、お三方には……もう少し担っていただくことになるかもしれません。数の上では、これまでより重くなります。"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（もう少し、担う……。）"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（人が減ったなら、欠けた分は誰かが埋めるしかない。そして、わたしの量が、いちばん高い。）"
            }
          ],
          "choices": [
            {
              "text": "（なら……わたしが、多く担おう）",
              "goto": "c3_5"
            }
          ]
        },
        {
          "id": "c3_5",
          "title": "もう少しだけ担ぐ",
          "on_enter": [
            "bg('bg/haiden.png')"
          ],
          "dialogue": [
            {
              "who": "葵",
              "state": "laugh",
              "say": "わたしが担います！量がいちばん高いのはわたしです。足りない分は、わたしが埋められます。"
            },
            {
              "say": "ほとんど、奪うようにして口にしていた。間宮は満足げに書き留め、結城はこちらを一度見て、何か言いかけて——結局は、うなずいただけだった。"
            },
            {
              "who": "結菜",
              "state": "laugh",
              "say": "じゃあわたしも多く担ぐ！葵ひとりに背負わせられないよ！"
            },
            {
              "who": "咲",
              "state": "calm",
              "say": "……わたしも、同じ。"
            },
            {
              "who": "葵",
              "state": "laugh",
              "say": "（わたしの数字が、また少し上がった。それが伸びていくのを見ていると、言いようもなく、地に足がつく。）"
            },
            {
              "who": "葵",
              "state": "laugh",
              "say": "（担うほどに、核心へ近づく。近づくほどに、皆の役に立てる。この未来の、役に立てる。）"
            },
            {
              "say": "それからは、以前よりずっと頻繁に舞った。舞だけではない。——掃く地面は増え、数える銭は増え、手を通す事のひとつひとつが、前より詰まっていった。承載の量は幾度も塗り替えられ、画面のわたしの曲線は、ひたすら上へ這い上がっていく。"
            },
            {
              "say": "舞のあとの余韻は、まだあたたかい。ただ、掘り抜かれたあの虚ろが、前より少しだけ深くなり、休む間もまた、前より少しだけ短くなっていた。"
            },
            {
              "say": "けれど気に留めなかった。わたしは、上がり続ける自分の数字を、誇るのに忙しかった。"
            }
          ],
          "choices": [
            {
              "text": "（もう少し。まだ担える）",
              "goto": "c3_end"
            }
          ]
        },
        {
          "id": "c3_end",
          "title": "第三章おわり",
          "dialogue": [
            {
              "say": "夜、横になる前に、昼間の這い上がっていく曲線をまた思い出した。"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（わたしの量がいちばん高い。わたしがいちばん担える。わたしが、あの場所にいちばん近い。）"
            },
            {
              "who": "葵",
              "state": "calm",
              "say": "（皆のため、未来のために、もう少し織れるのなら——もう少し担うくらい、何だというのだろう。）"
            },
            {
              "say": "満ち足りたまま、眠りに落ちた。"
            },
            {
              "say": "見えていなかった。——ひたすら上を向いていくあの曲線が測っているのは、自分から担ぎ去られた重さであること。そしてそれが高く這うほどに、自分は、空になっていくということを。"
            },
            {
              "say": "空いた席は、なおも一つ、また一つと現れ続けている。そしてそれを埋めているのは、ますます足しげく舞う、自分の姿だった。"
            }
          ],
          "choices": [
            {
              "text": "（第四章 · 開始）",
              "goto": "c4_1"
            }
          ]
        }
      ]
    }
  ]
}
