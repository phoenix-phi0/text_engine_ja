{
  "chapters": [
    {
      "id": "chapter11",
      "title": "化け物",
      "scenes": [
        {
          "id": "c11_1",
          "title": "軽率すぎる",
          "on_enter": [
            "bg('bg/hospital_room.png')"
          ],
          "music": "bgm/daily_calm.mp3",
          "dialogue": [
            {
              "say": "結城が来たとき、書類に署名した件を、包み隠さず話した。"
            },
            {
              "say": "喜んでくれるものと思っていた。——核心承載者。それが、どれほどの誉れか。"
            },
            {
              "say": "けれど彼の顔は、少しずつ、沈んでいった。"
            },
            {
              "who": "結城",
              "say": "……署名した？私に、ひと言もなく、署名したのですか。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "はい……あのとき、あなたはいらっしゃらなくて、わたしたち、よいことだと思って……"
            },
            {
              "who": "結城",
              "say": "よいこと？"
            },
            {
              "say": "彼は一歩前へ出て、そこで無理に足を止めた。怯えさせるのを、恐れたかのように。それでも声にこもった火は、抑えきれていなかった。"
            },
            {
              "who": "結城",
              "say": "あれは正式な文書だ！自分が何に署名したか、わかっているのですか。条項は、きちんと読んだのですか。この先どれだけ担うことになるか、考えましたか。"
            },
            {
              "who": "結城",
              "say": "……軽率すぎる。"
            },
            {
              "say": "口を開きかけて、ひと文字も、出てこなかった。"
            },
            {
              "who": "葵",
              "state": "bingfu_cry",
              "say": "（ごめんなさい……わたしたち、患者のことと、核心のことしか、考えていなかった。ほかのことは……何ひとつ、考えていなかった。）"
            },
            {
              "say": "彼は目を閉じ、長く長く息を吐いて、声を落とした。"
            },
            {
              "who": "結城",
              "say": "……私が悪い。あの場に、私がいるべきだった。あなたたちは、まだそんな年で——こんなことを、自分ひとりで背負うべきではなかった。"
            },
            {
              "say": "それきり、彼は叱らなかった。けれどその顔に浮かんだ悔いは、叱責より、ずっと重かった。"
            }
          ],
          "choices": [
            {
              "text": "（そして彼は訊いた）",
              "goto": "c11_2"
            }
          ]
        },
        {
          "id": "c11_2",
          "title": "例祭はどうする",
          "on_enter": [
            "bg('bg/hospital_room.png')"
          ],
          "dialogue": [
            {
              "who": "結城",
              "say": "では、教えてください。——例祭は、どうするのです。"
            },
            {
              "say": "言葉に、詰まった。"
            },
            {
              "who": "結城",
              "say": "あなたたちは協力を続けると承知した。向こうは日ごとに人を求めてくる。だが社では、例祭が目の前だ。宮司は、あなたたちが戻って承載するのを待っている。学校も、始まる。"
            },
            {
              "who": "結城",
              "say": "この三つを、どう分けるつもりですか。"
            },
            {
              "who": "葵",
              "state": "bingfu_cry",
              "say": "（……考えていなかった。署名したとき、わたしは、少しも考えていなかった。）"
            },
            {
              "say": "答えられなかった。結菜は唇を噛み、咲はうつむいて、誰も言葉が出てこなかった。"
            },
            {
              "say": "これが、彼の言う軽率だ。人を助けたい、美咲様のあの層まで行きたい——そればかりで、自分に手が幾つあるのかさえ、数えていなかった。"
            },
            {
              "who": "結城",
              "say": "……この件は、私ひとりでは決められない。宮司に来ていただいて、相談しましょう。"
            }
          ],
          "choices": [
            {
              "text": "（宮司が来た）",
              "goto": "c11_3"
            }
          ]
        },
        {
          "id": "c11_3",
          "title": "三つの頭",
          "on_enter": [
            "bg('bg/hospital_room.png')"
          ],
          "dialogue": [
            {
              "say": "宮司はすぐに来た。老人は結城の話を聞き終えると、しばらく声を出さず、ただ三人を、見て、また見た。"
            },
            {
              "who": "宮司",
              "say": "……署名は、してしもうた。ここまで来て、叱っても益はない。"
            },
            {
              "say": "彼は腰を下ろし、膝に手をついた。その姿は、一気に老けて見えた。"
            },
            {
              "who": "宮司",
              "say": "だが、例祭は逃れられん。新しく雇うた娘たちは、掃き掃除と受けまではできても、承載の力は、一年半年では身につかん。これは、前から申しておる。"
            },
            {
              "who": "宮司",
              "say": "例祭に承載する者がおらん——これは、事が起きるぞ。"
            },
            {
              "who": "結城",
              "say": "では、向こうは？向こうの協力も、止められません。署名した以上、あの患者たちの通路は開いたばかりで、人を離せない。止めると言って止めて、何か起きたら、誰が負うのです。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "（ごめんなさい……ぜんぶ、わたしのせい。わたしが、こんなふうにしてしまった。）"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "宮司。結城さん。わたしたちが、あまりに軽はずみでした。でも、患者のほうも、例祭のほうも……どちらも、投げ出したくありません。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "両方……どちらも、見ることはできませんか。もう少し、踏ん張ります。きっと、やりようがあります。"
            },
            {
              "say": "結城がこちらを見た。眉が、きつく寄せられている。"
            },
            {
              "who": "結城",
              "say": "身体は、まだ戻りきっていない。両方へ通って、保つのですか。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "保ちます。本当です。"
            },
            {
              "say": "言い切っていた。わたしは、いつもそうだ。——もう少し担えるのなら、いつだって「保ちます」と言う。"
            }
          ],
          "choices": [
            {
              "text": "（相談の結果）",
              "goto": "c11_4"
            }
          ]
        },
        {
          "id": "c11_4",
          "title": "週末",
          "on_enter": [
            "bg('bg/hospital_room.png')"
          ],
          "dialogue": [
            {
              "say": "相談の末に、折衷のやりようが決まった。"
            },
            {
              "say": "平日は学校へ通い、社を手伝い、例祭を支える。"
            },
            {
              "say": "週末は病院に二日泊まって——検査を受け、協力をし、あの患者たちを見る。"
            },
            {
              "who": "新田",
              "state": "default",
              "say": "その手配で、こちらは問題ありません。週末の量で、足ります。"
            },
            {
              "who": "宮司",
              "say": "……すまんな。例祭さえ過ぎて、社のほうが息をつけば、また別の手立てを考える。"
            },
            {
              "who": "結城",
              "say": "私が付き添います。週末はご一緒する。何かおかしければ、その場で止める。約束してください。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "はい。ありがとうございます、結城さん。"
            },
            {
              "say": "どちらも、見られることになった。学業、社、患者——ひとつも、落とさずに。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "（これでいい。両方できる。誰も、裏切らずに済む。）"
            },
            {
              "say": "胸のなかが、ずいぶん落ち着いた。荷物をまとめて、ついに、あの扉の外へ出た。"
            },
            {
              "say": "外の風が顔に当たる。もう、少しあたたかい。春が、終わろうとしていた。"
            }
          ],
          "choices": [
            {
              "text": "（始業）",
              "goto": "c11_5"
            }
          ]
        },
        {
          "id": "c11_5",
          "title": "始業",
          "on_enter": [
            "bg('bg/classroom.png')"
          ],
          "music": "bgm/school_bright.mp3",
          "dialogue": [
            {
              "say": "始業の日は、ずいぶん早く起きた。"
            },
            {
              "say": "制服を着て、鞄を背負う。鏡のなかの自分は、顔色こそ悪いけれど、ともかく、帰ってきたのだ。"
            },
            {
              "who": "葵",
              "state": "xueshengfu_laugh",
              "say": "（やっと学校に行ける。こんなに会っていないんだから、麻衣はきっと、話したいことが山ほどあるはず。）"
            },
            {
              "say": "道々、麻衣にメッセージを送った。「今日から学校に戻るよ！」"
            },
            {
              "say": "返事は、なかった。"
            },
            {
              "say": "まだ起きていないのだろう、と思った。"
            }
          ],
          "choices": [
            {
              "text": "（学校に着く）",
              "goto": "c11_6"
            }
          ]
        },
        {
          "id": "c11_6",
          "title": "教室",
          "on_enter": [
            "bg('bg/classroom.png')"
          ],
          "dialogue": [
            {
              "say": "教室の戸を引くと、なかは賑やかだった。"
            },
            {
              "say": "そして、その賑やかさが、止まった。"
            },
            {
              "say": "話していた者は口をつぐみ、笑っていた者は笑みを収めた。幾十もの視線がこちらに落ちて、すぐさま、逸れていった。"
            },
            {
              "who": "葵",
              "state": "xueshengfu",
              "say": "……お、おはよう。"
            },
            {
              "say": "誰も、応えなかった。"
            },
            {
              "say": "戸口で固まったまま、笑みだけが顔に残っていて、収めるべきか、残すべきか、わからなかった。"
            },
            {
              "say": "自分の席へ歩く。通ったところで、人が少しだけ、両側へ寄った。——はっきりとではない。それでも、わかってしまう。"
            },
            {
              "who": "葵",
              "state": "xueshengfu",
              "say": "（……どうしたの？わたし、何か、いけないことをした？）"
            }
          ],
          "choices": [
            {
              "text": "（麻衣を探す）",
              "goto": "c11_7"
            }
          ]
        },
        {
          "id": "c11_7",
          "title": "麻衣",
          "on_enter": [
            "bg('bg/classroom.png')"
          ],
          "dialogue": [
            {
              "say": "麻衣は窓ぎわで、何人かの女子と立っていた。歩み寄る。"
            },
            {
              "who": "葵",
              "state": "xueshengfu_laugh",
              "say": "麻衣！久しぶり——帰ってきたよ。"
            },
            {
              "say": "彼女が振り返った。こちらを、ひと目見た。"
            },
            {
              "say": "そして向き直り、隣の人と話を続けた。まるで、聞こえなかったかのように。"
            },
            {
              "who": "葵",
              "state": "xueshengfu",
              "say": "……麻衣？"
            },
            {
              "say": "彼女は、応じなかった。まわりの女子たちが目配せを交わし、誰も、声を出さなかった。"
            },
            {
              "say": "わたしの手は、まだ、半ばまで上がったままだった。"
            },
            {
              "who": "葵",
              "state": "xueshengfu_cry",
              "say": "（わたし、何か間違えた？メッセージも……返ってこなかった。何か、まずいことを言った？それとも……）"
            },
            {
              "say": "わからなかった。わたしはただ、長いこと学校に来ていなかっただけなのに。"
            }
          ],
          "choices": [
            {
              "text": "（そのとき）",
              "goto": "c11_8"
            }
          ]
        },
        {
          "id": "c11_8",
          "title": "化け物",
          "on_enter": [
            "bg('bg/classroom.png')"
          ],
          "music": null,
          "dialogue": [
            {
              "say": "まだそこに立って、もう一度、彼女を呼ぼうとしていた。"
            },
            {
              "say": "教室の反対側で、誰かが勢いよく椅子を押しのけて、立ち上がった。"
            },
            {
              "who": "生徒",
              "say": "——化け物、来るな！"
            },
            {
              "say": "大きな声だった。教室じゅうが、扇風機の回る音まで聞こえるほど、一瞬で静まりかえった。"
            },
            {
              "say": "その人自身も、自分の声に驚いたようだった。顔を真っ赤にして、それでも一歩、退き、また一歩、退いた。"
            },
            {
              "say": "誰も笑わなかった。誰も彼を咎めなかった。誰も「何を言っているの」とは、言わなかった。"
            },
            {
              "say": "皆はただ、見ていた。わたしを、見ていた。"
            },
            {
              "who": "葵",
              "state": "xueshengfu_calm",
              "say": "……化け物？"
            },
            {
              "say": "その言葉を、口のなかで、ひっくり返してみる。それはわたしの上に落ちてきて、まるで、まったく知らない誰かの上に叩きつけられたようだった。"
            },
            {
              "who": "葵",
              "state": "xueshengfu_calm",
              "say": "（……わたしが？）"
            },
            {
              "say": "麻衣が身を翻し、隣の人の手を引いて、行ってしまった。こちらを、見なかった。"
            },
            {
              "say": "わたしはまだ窓ぎわに立って、手のなかで、鞄の紐を握りしめていた。"
            },
            {
              "say": "始業の鐘が、鳴った。"
            }
          ],
          "choices": [
            {
              "text": "（第十二章 · 開始）",
              "goto": "c12_1"
            }
          ]
        }
      ]
    }
  ]
}
