{
  "chapters": [
    {
      "id": "chapter22",
      "title": "講評",
      "scenes": [
        {
          "id": "c22_1",
          "title": "順に",
          "on_enter": [
            "bg('bg/hospital_room.png')"
          ],
          "music": "bgm/daily_calm.mp3",
          "dialogue": [
            {
              "say": "拘束帯が解かれて三日目、大部屋へ呼ばれた。"
            },
            {
              "say": "大部屋は、人でいっぱいだった。患者、承載者、真我会の人たち。あの三人は、後ろの列に座っている。"
            },
            {
              "say": "中央に、椅子がひとつ置かれていた。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "白石さん、お掛けなさい。"
            },
            {
              "say": "腰を下ろした。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "先日のことは、皆さんご覧になった通りです。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "藤崎医師は皆さんのためを思っておられた。そこへ白石さんが、手を上げた。この件は、はっきりさせておかねばならない。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "今日は、講評をします。皆さん、それぞれ述べてください。"
            },
            {
              "say": "彼は、ぐるりと見回した。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "順に。ひとりも、抜かしてはいけません。"
            },
            {
              "say": "最初に立ち上がったのは、ひとりの患者だった。"
            },
            {
              "who": "患者",
              "say": "……白石さんは、このところ、情緒がたいへん不安定です。"
            },
            {
              "who": "患者",
              "say": "わたしたちの組は、あの人のせいで、この二週の点が落ちました。"
            },
            {
              "say": "言い終えると、彼女はすぐ座った。こちらを、見なかった。"
            },
            {
              "say": "二人目。三人目。"
            },
            {
              "who": "患者",
              "say": "あの日、手を上げて、皆をたいへん気まずくさせました。"
            },
            {
              "who": "患者",
              "say": "藤崎医師は、いい人です。"
            },
            {
              "say": "ひとり、またひとり。"
            },
            {
              "say": "窓ぎわのあの子も、立ち上がった。彼女はいま、骨ばかりに痩せていて、人に支えられて立った。"
            },
            {
              "who": "患者",
              "say": "……葵お姉ちゃん。"
            },
            {
              "say": "彼女は、うつむいていた。"
            },
            {
              "who": "患者",
              "say": "前のお姉ちゃんは、こうじゃなかった。"
            },
            {
              "say": "彼女は、座った。"
            },
            {
              "say": "わたしは、椅子に座っていた。"
            },
            {
              "say": "思った。——この人たちの言うことは、正しい。"
            },
            {
              "who": "葵",
              "state": "bingfu_calm",
              "say": "（わたしが、悪い。）"
            }
          ],
          "choices": [
            {
              "text": "（次の人）",
              "goto": "c22_2"
            }
          ]
        },
        {
          "id": "c22_2",
          "title": "咲",
          "on_enter": [
            "bg('bg/hospital_room.png')"
          ],
          "dialogue": [
            {
              "who": "黒木",
              "state": "default",
              "say": "次。小野寺さん。"
            },
            {
              "say": "咲は、座ったまま動かなかった。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "小野寺さん？"
            },
            {
              "who": "咲",
              "state": "bingfu",
              "say": "……"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "これは講評です。あなたの番ですよ。"
            },
            {
              "say": "彼は、手にした帳面を繰った。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "ああ、それと、ひとつ申し上げておきます。今日発言しない者は、不協力として記録します。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "あなたひとりを記すのではない——あなたの組を、記すのです。"
            },
            {
              "say": "咲が、顔を上げた。"
            },
            {
              "say": "彼女は後ろの列を見て、それから、自分の組の人たちを見た。"
            },
            {
              "say": "彼女の組の人たちも、彼女を見ていた。"
            },
            {
              "say": "彼女は、立ち上がった。"
            },
            {
              "who": "咲",
              "state": "bingfu",
              "say": "……白石さんは、会の場で、人に手を上げました。"
            },
            {
              "say": "その声は、平たかった。"
            },
            {
              "who": "咲",
              "state": "bingfu",
              "say": "これは情緒の失控です。藤崎医師に傷害を与え、皆さんに困惑を与えました。"
            },
            {
              "who": "咲",
              "state": "bingfu",
              "say": "あの人の状態は、このところずっとよくありませんでした。わたしも同じ組長として、もっと早く注意を促すべきでした。これは、わたしの失職です。"
            },
            {
              "who": "咲",
              "state": "bingfu",
              "say": "戒めとします。"
            },
            {
              "say": "彼女は、たいへん流暢に言った。"
            },
            {
              "say": "彼女は昔から、何を学ぶのも、速かった。"
            },
            {
              "say": "言い終えて、彼女は座った。"
            },
            {
              "say": "彼女は、こちらを見なかった。"
            },
            {
              "say": "はじめから終わりまで、一度も。"
            },
            {
              "say": "拍手。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "たいへん結構。小野寺さんが、いちばん的を射ていた。"
            },
            {
              "say": "椅子に座って、彼女の後ろ頭を、見ていた。"
            },
            {
              "who": "葵",
              "state": "bingfu_vacant",
              "say": "（……ごめんなさい。）"
            },
            {
              "who": "葵",
              "state": "bingfu_vacant",
              "say": "（わたしが、あなたを巻きこんだ。）"
            }
          ],
          "choices": [
            {
              "text": "（講評が終わって）",
              "goto": "c22_3"
            }
          ]
        },
        {
          "id": "c22_3",
          "title": "謝罪",
          "on_enter": [
            "bg('bg/hospital_room.png')"
          ],
          "music": "bgm/daily_calm.mp3",
          "dialogue": [
            {
              "say": "ひと回りして、皆、述べ終えた。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "はい。白石さん、皆さんの言葉は、すべて聞きましたね。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "ご自分でも、述べてください。"
            },
            {
              "say": "立ち上がった。"
            },
            {
              "say": "藤崎医師は、前の列に座っていた。顔には、まだ痣がひとつ残っている。"
            },
            {
              "say": "何を言うべきかは、わかっていた。"
            },
            {
              "say": "この言葉は、もう、たいへん慣れていた。"
            },
            {
              "say": "彼に向かって、礼をした。深く。"
            },
            {
              "who": "葵",
              "state": "bingfu_calm",
              "say": "藤崎医師。あの日は、わたしが失態を致しました。"
            },
            {
              "who": "葵",
              "state": "bingfu_calm",
              "say": "わたしは、あなたを打ちました。"
            },
            {
              "say": "腰は、たいへん低く折れていた。あるべき角度まで、低く。"
            },
            {
              "who": "葵",
              "state": "bingfu_calm",
              "say": "あなたはずっと、わたしたちのためを思ってくださっていた。わたしが、恩を弁えなかったのです。"
            },
            {
              "who": "葵",
              "state": "bingfu_calm",
              "say": "皆さんにご迷惑をかけ、この組の点を、落としました。"
            },
            {
              "say": "ここで、ひとつ、間を置いた。"
            },
            {
              "say": "ちょうどよく、置いた。"
            },
            {
              "who": "葵",
              "state": "bingfu_calm",
              "say": "……申し訳、ありませんでした。"
            },
            {
              "say": "声が、少し震えた。"
            },
            {
              "say": "震わせたのは、わたしだった。"
            },
            {
              "who": "葵",
              "state": "bingfu_calm",
              "say": "今後は、必ず改めます。"
            },
            {
              "say": "身を起こし、皆のほうへ向き直って、また、礼をした。"
            },
            {
              "who": "葵",
              "state": "bingfu_calm",
              "say": "皆さまのご批判は、すべて記しました。"
            },
            {
              "who": "葵",
              "state": "bingfu_calm",
              "say": "ありがとうございます。"
            },
            {
              "say": "大部屋が、ひと瞬、静まった。"
            },
            {
              "say": "それから、拍手が起きた。"
            },
            {
              "say": "たいへん、響いた。"
            },
            {
              "say": "藤崎医師が立ち上がり、歩いてきて、こちらを支えた。"
            },
            {
              "who": "藤崎",
              "state": "default",
              "say": "かまいませんよ、白石さん。"
            },
            {
              "who": "藤崎",
              "state": "default",
              "say": "あの日のことは、あなたのせいではない。急性激越は症状の一部です。あなたの本意では、ありません。"
            },
            {
              "who": "藤崎",
              "state": "default",
              "say": "皆の前で、こうして得心できたということは、たいへんよく回復している証拠です。"
            },
            {
              "say": "彼は、わたしの肩を、ひとつ叩いた。"
            },
            {
              "who": "藤崎",
              "state": "default",
              "say": "わたしは、たいへん嬉しい。"
            },
            {
              "say": "拍手が、さらに響いた。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "よし！これでこそ、態度というものだ！"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "記録を——白石葵、衆に当たって謝意を致す、認識深刻。この組の減点は、半減。"
            },
            {
              "say": "下のほうで、誰かが息を吐いた。"
            },
            {
              "say": "誰も、こちらを見なかった。"
            },
            {
              "say": "席へ戻って、座った。"
            },
            {
              "who": "葵",
              "state": "bingfu_calm",
              "say": "（……成った。）"
            },
            {
              "say": "半減。この組のこの月は、まだ、取り返せる。"
            },
            {
              "say": "帳面を開いて、来週の当番を、算しはじめた。"
            }
          ],
          "choices": [
            {
              "text": "（宮司が知った）",
              "goto": "c22_4"
            }
          ]
