{
  "chapters": [
    {
      "id": "chapter15",
      "title": "一日に二度",
      "scenes": [
        {
          "id": "c15_1",
          "title": "間瀬さんが去った",
          "on_enter": [
            "bg('bg/lab_room.png')"
          ],
          "music": "bgm/sad_gentle.mp3",
          "dialogue": [
            {
              "say": "間瀬が、異動になる。"
            },
            {
              "say": "別のところで新しい一件が起こり、腕の立つ者が要るのだという。手続きは、たいへん速く済んだ。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "……引き継ぎの分は、すべて書いておきました。どの段も、飛ばすことはできない。はっきりと、書いてある。"
            },
            {
              "say": "彼は書類の束を台の上に置き、押さえて、平らにした。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "白石さん。あなたたち三人、身体を、大事にしてください。"
            },
            {
              "say": "彼はしばらく間を置いた。まだ、何か言おうとしているようだった。"
            },
            {
              "who": "間瀬",
              "state": "default",
              "say": "……具合が悪ければ、そう言いなさい。意地を、張らないように。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "はい。ありがとうございました、間瀬さん。"
            },
            {
              "say": "彼はうなずいて、鞄を提げ、行った。"
            },
            {
              "say": "彼はずっと、「承載は螺子を締めるのとは違う」と言い続けた人だった。"
            },
            {
              "say": "いま、その人が、去った。"
            }
          ],
          "choices": [
            {
              "text": "（結城さんのほうは）",
              "goto": "c15_2"
            }
          ]
        },
        {
          "id": "c15_2",
          "title": "手が回らない",
          "on_enter": [
            "bg('bg/hospital_corridor.png')"
          ],
          "dialogue": [
            {
              "say": "結城が来る回数も、減った。"
            },
            {
              "say": "計画が拡がっている。新しい人が、ひと束またひと束と入ってきて、どれにも、見る者が要る。彼は能があり、皆が彼を信じる——だから、彼に振られるものが、いちばん多い。"
            },
            {
              "say": "その日、廊下ですれ違った。彼は足を止めた。手には、まだ書類の束を抱えている。"
            },
            {
              "who": "結城",
              "say": "葵。……すまない。このところ、本当に、手が回らない。"
            },
            {
              "who": "結城",
              "say": "あなたたち三人のことは、まだ上へ掛け合っています。いま少し、忍んでください。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "はい。わたしたちは、平気です。"
            },
            {
              "who": "結城",
              "say": "何かあれば、必ず、私を探しなさい。いつでも、行きます。"
            },
            {
              "say": "彼は、本気で言っていた。"
            },
            {
              "say": "そのとき、階段口で誰かが彼を呼んだ。彼はひと言応じて、足早に、行った。"
            },
            {
              "say": "それから半月、彼を見なかった。"
            }
          ],
          "choices": [
            {
              "text": "（検査室）",
              "goto": "c15_3"
            }
          ]
        },
        {
          "id": "c15_3",
          "title": "一日に二度",
          "on_enter": [
            "bg('bg/lab_room.png')"
          ],
          "music": "bgm/tension_low.mp3",
          "dialogue": [
            {
              "say": "検査室では、いま、飼部が仕切っている。"
            },
            {
              "say": "彼は相変わらずだった。うつむいて、あまり口をきかず、手もとの動きは、速く、そして、安定している。"
            },
            {
              "say": "あの三人は、脇に立って、表を見ていた。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "飼部さん。今日のこの一回が済んだら、午後にもう一回、入れられますよね？"
            },
            {
              "who": "飼部",
              "state": "default",
              "say": "……数の上では、可能です。"
            },
            {
              "who": "黒木",
              "state": "default",
              "say": "では、入れましょう。上が、進度を見たがっている。"
            },
            {
              "say": "飼部は何も言わず、うつむいて、予定表を書き替えた。"
            },
            {
              "say": "その日から、一日に、二度になった。"
            },
            {
              "say": "以前、間瀬がいたころは、一日に一度。あいだには、じゅうぶんに時間を置いた。"
            },
            {
              "say": "いま、その一句を言う者は、いない。"
            },
            {
              "say": "一度目を終えて、台の上に長いこと横たわって、ようやく、起き上がれた。二度目も、三度目も、同じだった。"
            },
            {
              "say": "結菜の顔色は、ぞっとするほど白い。咲は、日ごとに、口数が減っていった。"
            }
          ],
          "choices": [
            {
              "text": "（あの日の承載）",
              "goto": "c15_4"
            }
          ]
        },
        {
          "id": "c15_4",
          "title": "あの日",
          "on_enter": [
            "bg('bg/lab_room.png')"
          ],
          "dialogue": [
            {
              "say": "その日の承載も、いつも通りに始まった。"
            },
            {
              "say": "横たわり、目を閉じ、心を、定める。沈んで、落ちてくる。"
            },
            {
              "say": "そして、何かが、狂った。"
            },
            {
              "say": "痛みではない。別のものだった。"
            },
            {
              "say": "身体の底から、何かが湧き上がってくる。熱くて、乱れていて、こちらを押しのけて、言うことを、きかない。"
            },
            {
              "who": "葵",
              "state": "bingfu_pain",
              "say": "（……なに。これは、なに。）"
            },
            {
              "say": "押さえこもうとする。押さえきれない。"
            },
            {
              "say": "身体が、動いている。自分の呼吸が変わったのが、聞こえる。唇を噛んで、きつく噛んで——それでもその声は、漏れて、出た。"
            },
            {
              "say": "目が、開けられない。開ける勇気が、なかった。"
            },
            {
              "say": "とても、とても長い、ひとときだった。"
            },
            {
              "say": "そして、それは、退いていった。"
            },
            {
              "say": "検査室は、静かだった。台の上に横たわったまま、全身が、汗だった。"
            },
            {
              "say": "誰かが、笑うのが聞こえた。"
            },
            {
              "say": "見る勇気が、なかった。顔を、向こう側へ背けた。——誰かが来て、こちらを支え起こすまで。"
            },
            {
              "who": "葵",
              "state": "bingfu_cry",
              "say": "（……あれは、なに。）"
            },
            {
              "who": "葵",
              "state": "bingfu_cry",
              "say": "（わたし、どうして……あんなときに……）"
            },
            {
              "say": "あれは、神事のときだ。"
            },
            {
              "say": "顔を枕に埋めた。全身が、震えていた。"
            }
          ],
          "choices": [
            {
              "text": "（技術の人たちへ）",
              "goto": "c15_5"
            }
          ]
        },
        {
          "id": "c15_5",
          "title": "こちらの管轄ではない",
          "on_enter": [
            "bg('bg/lab_room.png')"
          ],
          "dialogue": [
            {
              "say": "翌日、技術の一隊のところへ、行った。"
            },
            {
              "who": "葵",
