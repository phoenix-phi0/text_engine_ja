          "music": "bgm/sad_gentle.mp3",
          "dialogue": [
            {
              "say": "夜、目が冴えていた。"
            },
            {
              "say": "以前は毎日、眠る前に、社の方角へひとつ拝をしていた。"
            },
            {
              "say": "ここに住みついてからも、絶やさなかった。窓は西向きで、社は、そちらにある。"
            },
            {
              "say": "身体を支えて、寝台の縁に、腰を下ろした。"
            },
            {
              "say": "窓の外は、たいへん暗い。その方角を、長いこと、見ていた。"
            },
            {
              "say": "そして、あのことを、思い出した。"
            },
            {
              "say": "台の上での、自分の様子を思い出した。あの言葉が、自分の口から出ていったことを、思い出した。"
            },
            {
              "say": "黒木さまに、感謝します。"
            },
            {
              "say": "あの人たちの、笑い声を思い出した。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "（……わたしのような人間が。）"
            },
            {
              "say": "巫女は、清くなければならない。斎戒し、沐浴し、身も心も清らかにして、神前に立たなければならない。"
            },
            {
              "say": "うつむいて、自分の手を、見た。"
            },
            {
              "who": "葵",
              "state": "bingfu_cry",
              "say": "（わたしのような人間に、まだ、その資格があるの。）"
            },
            {
              "say": "拝は、しなかった。"
            },
            {
              "say": "横に、なった。"
            },
            {
              "say": "その日から二度と、あの方角へ、拝をすることはなかった。"
            },
            {
              "say": "誰も、気づかなかった。"
            }
          ],
          "choices": [
            {
              "text": "（新しい規矩）",
              "goto": "c18_3"
            }
          ]
