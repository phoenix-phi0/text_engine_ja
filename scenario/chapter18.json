      "title": "きちんと向き合う",
      "scenes": [
        {
          "id": "c18_1",
          "title": "監督",
          "on_enter": [
            "bg('bg/lab_room.png')"
          ],
          "music": "bgm/daily_calm.mp3",
          "dialogue": [
            {
              "say": "結城が、監督権を勝ち取った。"
            },
            {
              "say": "上が認めたのは——抽出のあいだ、立ち会ってよい、ということ。"
            },
            {
              "say": "抽出のあいだ、だけ。"
            },
            {
              "who": "新田",
              "state": "default",
              "say": "結城さん、規矩を先に申し上げます。監督のあいだ、承載者と言葉を交わすことはできません。"
            },
            {
              "who": "新田",
              "state": "default",
              "say": "外部の接触は、承載者の状態を乱します。医学上の意見です。"
            },
            {
              "say": "結城は、何も言わなかった。"
            },
            {
              "say": "彼は検査室の隅に、立った。"
            },
            {
              "say": "その日の抽出は、きれいに、きちんと行われた。"
            },
            {
              "say": "あの三人は、まっすぐに立っていた。無駄口ひとつ、なかった。柏原は、顔を上げることさえ、しなかった。"
            },
            {
              "say": "志摩は台のかたわらに立って、相変わらず、ずっと見ていた。"
            },
            {
              "say": "結城がいるときも、彼は見ていた。ただ、笑わなかった。"
            },
            {
              "say": "横になり、目を閉じ、身動きひとつせずに、受けきった。"
            },
            {
              "say": "笑い声は、なかった。何も、なかった。"
            },
            {
              "say": "終わって、台から助け下ろされた。"
            },
            {
              "say": "結城は、そこに立っていた。こちらを見ているのが、わかった。"
            },
            {
              "say": "顔を、上げなかった。"
            },
            {
              "who": "葵",
              "state": "bingfu",
              "say": "（……見ないで。）"
            },
            {
              "say": "そのまま、押し出されていった。"
            },
            {
              "say": "戸が、背後で閉まった。"
            },
            {
              "say": "彼が見たのは、たいへん規矩に適った、抽出だった。"
            }
          ],
          "choices": [
            {
              "text": "（その日の夜）",
              "goto": "c18_2"
            }
          ]
