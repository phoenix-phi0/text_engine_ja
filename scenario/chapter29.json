{
  "chapters": [
    {
      "id": "chapter29",
      "title": "帳簿",
      "scenes": [
        {
          "id": "c29_1",
          "title": "接続",
          "on_enter": [
            "bg('bg/kensa_room.png')"
          ],
          "music": "bgm/tension_low.mp3",
          "dialogue": [
            { "say": "体系は、夜のうちに何人か招集した。" },
            { "say": "彼らは検査室の一番奥に座り、目の前に画面がずらりと並んでいる。" },
            { "say": "鹿島さんは、あの未知の波形を長いあいだ見つめていた。" },
            { "who": "鹿島", "state": "default", "say": "ピーク抽出、対象を差し替える。" },
            { "who": "間瀬", "state": "default", "say": "……誰に。" },
            { "who": "鹿島", "state": "default", "say": "この新しいのにだ。" },
            { "who": "鹿島", "state": "default", "say": "通路が広くて、新しい。まったく使われていない。" },
            { "who": "鹿島", "state": "default", "say": "白石さんは、出なくていい。" },
            { "say": "あなたは壁際に座っていた。" },
            { "say": "それを、聞いた。" },
            { "say": "どういう気持ちなのか、自分でも言えなかった。" },
            { "who": "間瀬", "state": "default", "say": "しかし、どこにいるのかも分からない。どうやって抽く。" },
            { "who": "鹿島", "state": "default", "say": "人を見つける必要はない。" },
            { "who": "鹿島", "state": "default", "say": "リンクは、もう繋がっている。" },
            { "say": "技術者の一人が、こちらを振り向いた。" },
            { "say": "相手と話す手段は、一つしかないという。" },
            { "say": "対話精霊、というもの。" },
            { "say": "向こうには、そのメッセージを誰が送っているのか分からない。" },
            { "who": "結城", "say": "……私がやる。" },
            { "say": "結城さんは、ずっと戸口に立っていた。" },
            { "who": "結城", "say": "権限がある。" },
            { "who": "鹿島", "state": "default", "say": "他の人間でもできる。" },
            { "who": "結城", "say": "私がやる。" },
            { "say": "彼は歩いていき、画面の前に腰を下ろした。" }
          ],
          "choices": [
            { "text": "（接続）", "goto": "c29_2" }
          ]
        },
        {
          "id": "c29_2",
          "title": "挑発",
          "on_enter": [
            "bg('bg/kensa_room.png')"
          ],
          "music": null,
          "dialogue": [
            { "say": "画面に、一行の文字が現れた。" },
            { "say": "向こうから送られてきたものだ。" },
            { "who": "リ・チゲン", "state": "cry", "say": "まさか、この不出来な身体でも、神様に受け入れてもらえるとはね。" },
            { "who": "リ・チゲン", "state": "default", "say": "どうです、上級の皆さん。" },
            { "who": "リ・チゲン", "state": "default", "say": "皮肉も言えなくなるまで、抽いてみますか。" },
            { "who": "リ・チゲン", "state": "default", "say": "少し、お仕置きでもしてみたいですか。" },
            { "who": "リ・チゲン", "state": "default", "say": "この無礼な振る舞いを、後悔させたい?" },
            { "who": "リ・チゲン", "state": "default", "say": "どうして黙っているんです。" },
            { "who": "リ・チゲン", "state": "default", "say": "図星でしたか。" },
            { "say": "あなたに見えたのは、結城さんの手が拳に握られたことだけだった。" }
          ],
          "choices": [
            { "text": "（返信）", "goto": "c29_3" }
          ]
        },
        {
          "id": "c29_3",
          "title": "帳簿",
          "on_enter": [
            "bg('bg/kensa_room.png')"
          ],
          "dialogue": [
            { "say": "結城さんが打ち始めた。" },
            { "say": "とても遅い。一字、また一字。" },
            { "who": "結城", "say": "私は、実際にお前を傷つけたりはしない。" },
            { "who": "結城", "say": "脅しもしない。暴力で「お仕置き」もしない。" },
            { "who": "結城", "say": "だが、お前の望むそのお仕置きなら、話して聞かせてやれる。" },
            { "who": "結城", "say": "脅しではない。事実だ。" },
            { "who": "結城", "say": "お前の身体は、空にされる。" },
            { "who": "結城", "say": "回復力は落ちる。" },
            { "who": "結城", "say": "時おりの衰弱が、年中の衰弱になる。" },
            { "who": "結城", "say": "免疫は下がり続ける。何度も病気になる。風邪をひき続け、感染を繰り返す。" },
            { "who": "結城", "say": "慢性疲労。もう元には戻らない種類のものだ。" },
            { "who": "結城", "say": "数日の話ではない。一生の話だ。" },
            { "who": "結城", "say": "どこまで行けるか、何を選べるか。そのすべてが制限される。" },
            { "say": "向こうからの返信はない。" },
            { "who": "結城", "say": "次は、頭のことだ。" },
            { "who": "結城", "say": "悪夢を見続ける。記憶は砕ける。感情は制御できなくなる。" },
            { "who": "結城", "say": "長く続けば判断力が壊れ、自分が自分だと分からなくなる。" },
            { "who": "結城", "say": "お前は今、挑発するのが痛快だろう。" },
            { "who": "結城", "say": "その痛快さは、すり減っていく。" },
            { "who": "結城", "say": "最後に残るのは、麻痺と、恥だけだ。" },
            { "who": "結城", "say": "お前は、標本になる。" },
            { "who": "結城", "say": "記録され、分析され、他の節点を訓練するために使われる。" },
            { "who": "結城", "say": "お前の姿も、お前のやったことも、記録に入り、展示に入る。" },
            { "who": "結城", "say": "誰でも好きに使える代物になる。" },
            { "who": "結城", "say": "お前の周りの人間も、守られない。" },
            { "who": "結城", "say": "お前を助けた者は、異動させられ、買収される。" },
            { "who": "結城", "say": "友人はどんどん減るか、どんどん危うくなる。" },
            { "who": "結城", "say": "お前にはラベルが貼られる。「ああいう人間」と。" },
            { "who": "結城", "say": "仕事も、信用も、この先のあらゆる道も、その一言に塞がれる。" },
            { "who": "結城", "say": "お前は、演じさせられる。" },
            { "who": "結城", "say": "人前で従順を示し、悔悛を示す。" },
            { "who": "結城", "say": "屈辱的で、消耗する。演じ終われば、それは彼らの物語に編集され、何度も繰り返し流される。" },
            { "who": "結城", "say": "崩れたら——人前で反撃したら——" },
            { "who": "結城", "say": "倍にして返ってくる。もっと見えにくいやり方で。" },
            { "who": "結城", "say": "お前の周りの人間ごと。" },
            { "who": "結城", "say": "お前はこれをゲームだと思っている。" },
            { "who": "結城", "say": "挑発を、ちょっとした戯れだと思っている。" },
            { "who": "結城", "say": "我々はそこらの実験室ではない。お前もそこらの猫とネズミではない。" },
            { "who": "結城", "say": "お前は見抜かれている。お前の一歩一歩が、帳簿に記されている。" },
            { "who": "結城", "say": "我々が求めているのは安定した産出だ。劇的な爆発ではない。" },
            { "say": "……" },
            { "who": "結城", "say": "自分は無傷でいられると、思い続けてもいい。" },
            { "who": "結城", "say": "だが本当の代償は、今の衰弱ではない。" },
            { "who": "結城", "say": "この先だ。お前は、注釈一つになるまで消費し尽くされる。" },
            { "who": "結城", "say": "名前が一つ、写真が一枚、繰り返し再生される教科書の一文。" },
            { "who": "結城", "say": "そのとき、分かる。" },
            { "who": "結城", "say": "無礼が連れてくるのは、自由ではない。" },
            { "who": "結城", "say": "正確に切り分けられ、ゆっくりと消耗させられることだ。" },
            { "who": "結城", "say": "まだ余力があるなら、自分を守るために使え。" },
            { "who": "結城", "say": "見せびらかすために使うな。" },
            { "say": "彼は打ち終えた。" },
            { "say": "その手が、震えていた。" },
            { "who": "結城", "say": "……分かったか。" },
            { "say": "画面は、長いあいだ動かなかった。" },
            { "say": "やがて、一行の文字が現れた。" },
            { "who": "リ・チゲン", "state": "calm", "say": "代償は、知っています。" },
            { "who": "リ・チゲン", "state": "calm", "say": "私を喰らう気は、ありますか。上級の皆さん。" },
            { "say": "結城さんは、その一行を見つめていた。" },
            { "say": "それ以上、打たなかった。" }
          ],
          "choices": [
            { "text": "（向こう側）", "goto": "c29_4" }
          ]
        },
        {
          "id": "c29_4",
          "title": "長すぎる",
          "on_enter": [
            "bg('bg/kensa_room.png')"
          ],
          "music": "bgm/tension_low.mp3",
          "dialogue": [
            { "say": "ピーク抽出が始まった。" },
            { "say": "リンクの向こうにいるのは、あなたが一度も会ったことのない人間だ。" },
            { "say": "読み値は、一気に天井まで上がった。" },
            { "say": "そして、そこで止まった。" },
            { "say": "動かない。" },
            { "who": "間瀬", "state": "default", "say": "……振り切れている。" },
            { "who": "間瀬", "state": "default", "say": "ずっと、振り切れたままだ。" },
            { "say": "鹿島さんが画面をにらんだ。" },
            { "who": "鹿島", "state": "default", "say": "何分だ。" },
            { "who": "間瀬", "state": "default", "say": "二十分。" },
            { "say": "その線は、平らだった。" },
            { "say": "最高値のところで、平らだった。" },
            { "who": "間瀬", "state": "default", "say": "三十分。" },
            { "who": "間瀬", "state": "default", "say": "通路はまだ開いている。潰れていない。" },
            { "who": "鹿島", "state": "default", "say": "……おかしい。" },
            { "who": "鹿島", "state": "default", "say": "ピークってのは峰だ。上がって、下りる。" },
            { "who": "鹿島", "state": "default", "say": "天井まで行ったなら、焼けるはずだ。" },
            { "say": "彼は画面に近づいた。" },
            { "who": "鹿島", "state": "default", "say": "こいつは、天井に三十分いる。" },
            { "who": "鹿島", "state": "default", "say": "どうして、まだ持っている。" },
            { "say": "誰も、答えなかった。" },
            { "say": "その線は、まだ平らだった。" }
          ],
          "choices": [
            { "text": "（リダイレクト）", "goto": "c29_5" }
          ]
        },
        {
          "id": "c29_5",
          "title": "リダイレクト",
          "on_enter": [
            "bg('bg/kensa_room.png')"
          ],
          "music": null,
          "dialogue": [
            { "say": "隅で、飼部さんが動いた。" },
            { "say": "彼はずっとそこに立って、機器を見ていた。" },
            { "say": "その彼が台の脇まで来て、パネルを何度か押した。" },
            { "say": "読み値が変わった。" },
            { "say": "あの平らな線が、ふいに一度歪んだ。" },
            { "say": "鹿島さんの顔色が変わった。" },
            { "who": "鹿島", "state": "default", "say": "……通路をいじったな。" },
            { "who": "間瀬", "state": "default", "say": "何だと?" },
            { "who": "鹿島", "state": "default", "say": "リダイレクトだ。地脈が通る経路を、別の道に切り替えた。" },
            { "say": "彼は飼部をにらみつけた。" },
            { "say": "飼部さんは、顔を上げなかった。" },
            { "say": "自分の仕事をしている。" },
            { "say": "画面に、一行の文字が現れた。" },
            { "who": "リ・チゲン", "state": "default", "say": "……あれ?" },
            { "who": "リ・チゲン", "state": "default", "say": "さっきまでの感じが、なくなった。" },
            { "who": "リ・チゲン", "state": "default", "say": "地面から上がってくる、あの冷たいやつ。" },
            { "who": "リ・チゲン", "state": "default", "say": "どうしたんです、上級の皆さん。" },
            { "say": "結城さんの手が、キーボードに置かれた。" },
            { "say": "まだ打っていない。" },
            { "say": "それより先に、画面に文字が出た。" },
            { "say": "彼が打ったものではない。" },
            { "who": "黒木", "state": "default", "say": "感じ、だって? 無いものに、どうして感じがあるんだい。" },
            { "say": "あなたは振り返った。" },
            { "say": "黒木さんが後ろに座り、自分のノートパソコンを膝に広げている。" },
            { "say": "打つのが、とても速い。" },
            { "who": "黒木", "state": "default", "say": "考えすぎじゃないのかな。" },
            { "who": "黒木", "state": "default", "say": "新人だからね。緊張する。普通のことだよ。" },
            { "who": "結城", "say": "黒木さん。" },
            { "who": "黒木", "state": "default", "say": "おやおや、私にも権限はありますよ。" },
            { "say": "彼は顔を上げなかった。" },
            { "who": "黒木", "state": "default", "say": "いい話し相手になっているじゃないですか。" }
          ],
          "choices": [
            { "text": "（おかしい）", "goto": "c29_6" }
          ]
        },
        {
          "id": "c29_6",
          "title": "熱を持つ",
          "on_enter": [
            "bg('bg/kensa_room.png')"
          ],
          "dialogue": [
            { "say": "鹿島さんは、ずっと読み値をにらんでいた。" },
            { "say": "その線の高さが、ゆっくりと下がってきた。" },
            { "who": "間瀬", "state": "default", "say": "……流量が落ちている。" },
            { "who": "鹿島", "state": "default", "say": "落ちてるんじゃない。" },
            { "say": "彼は別の数値を指した。" },
            { "who": "鹿島", "state": "default", "say": "詰まってるんだ。" },
            { "who": "鹿島", "state": "default", "say": "地脈の経路を切り替えられて、入ってこない。" },
            { "who": "鹿島", "state": "default", "say": "だが通路は開いたままで、抽き続けている。" },
            { "who": "鹿島", "state": "default", "say": "抽くものがなければ、通路そのものを削る。" },
            { "say": "彼は温度の欄を見た。" },
            { "who": "鹿島", "state": "default", "say": "熱を持ってきている。" },
            { "say": "彼は足早に画面の前へ行った。" },
            { "who": "鹿島", "state": "default", "say": "おい。" },
            { "who": "鹿島", "state": "default", "say": "そっちで、何かおかしいと感じたら——何かが押し返してきたら——" },
            { "who": "鹿島", "state": "default", "say": "すぐに言え。" },
            { "who": "鹿島", "state": "default", "say": "一文字でいい。" },
            { "say": "その後ろから、また文字が現れた。" },
            { "who": "黒木", "state": "default", "say": "おやおや鹿島さん、怖がらせてしまいますよ。" },
            { "who": "黒木", "state": "default", "say": "大丈夫、大丈夫。" },
            { "say": "結城さんが振り返った。" },
            { "who": "黒木", "state": "default", "say": "おとなしく横になっていればいい。少し我慢すれば、すぐ終わる。" },
            { "who": "黒木", "state": "default", "say": "しかし君、口だけは誰よりよく回るのに、身体のほうもなかなか丈夫じゃないか。" },
            { "say": "画面が、一瞬止まった。" },
            { "say": "そして、文字が現れた。" },
            { "who": "リ・チゲン", "state": "default", "say": "……あなたたちは、私が何なのか知らない。" },
            { "who": "リ・チゲン", "state": "default", "say": "焼かれますよ。" }
          ],
          "choices": [
