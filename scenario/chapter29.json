          ],
          "music": null,
          "dialogue": [
            { "say": "一番奥の技術者が、勢いよく立ち上がった。" },
            { "who": "新田", "state": "default", "say": "高エネルギー反応、検出!" },
            { "say": "すべての画面が、いっせいに警報を上げた。" },
            { "say": "その線が、天井を突き破った。" },
